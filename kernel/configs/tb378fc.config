# SPDX-License-Identifier: GPL-2.0-only
# Lenovo Xiaoxin Pad Pro GT 13 (TB378FC / SM8750P) modular board fragment.
# Merge on top of arm64 defconfig + sm8750-{netfilter,peripherals,snap,virt,waydroid}.config.

# Trim unrelated SoC families for lean arm64 builds (keep VEXPRESS for QEMU smoke).
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_VEXPRESS=y

# Release identity & bootconfig
CONFIG_LOCALVERSION="-tb378fc"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BOOT_CONFIG=y
CONFIG_QCOM_ABL_ROOT_IDENTITY=y

# Core initramfs, storage, and filesystems (all built-in for direct root mount)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_CONFIGFS_FS=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_HWMON=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_PSI=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_KVM is not set
# CONFIG_KUNIT is not set
# CONFIG_WERROR is not set

# SM8750P core SoC clocks, pinctrl, RPMh, interconnect, serial, watchdog
CONFIG_SM_GCC_8750=y
CONFIG_SM_TCSRCC_8750=y
CONFIG_SM_DISPCC_8750=y
CONFIG_SM_GPUCC_8750=y
CONFIG_SM_VIDEOCC_8750=m
CONFIG_SM_CAMCC_8750=m
CONFIG_PINCTRL_SM8750=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMHPD=y
CONFIG_INTERCONNECT_QCOM_SM8750=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_GPIO=m
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_QCOM_SPMI_ADC_TM5_GEN3=m
CONFIG_GUNYAH_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
CONFIG_HOTPLUG_PCI_PCIE=y

# QCE holds an always-on interconnect vote that blocks CX collapse in s2idle.
# CONFIG_CRYPTO_DEV_QCE is not set

# Display & Touch (built-in for immediate initramfs/VT bring-up)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_TB378FC_NT36526=y
CONFIG_REGULATOR_TB378FC_BIAS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_TB378FC_AW99706B=y
CONFIG_TOUCHSCREEN_NT36536_SPI=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_HIDRAW=y

# USB-C Dual-Role, DisplayPort Alt Mode, and opt-in tb378fc.debug=1 USB gadget
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# CONFIG_USB_CONFIGFS_SERIAL is not set
# CONFIG_USB_CONFIGFS_OBEX is not set
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_CONFIGFS_ECM_SUBSET is not set
# CONFIG_USB_CONFIGFS_EEM is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_CONFIGFS_F_FS is not set
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_UAS=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_TYPEC_MUX_WCD939X_USBSS=y

# Network congestion control & packet pacing (BBR + FQ + CAKE)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_CAKE=m

# ADSP remoteproc, PMIC GLINK, Battery, FastRPC sensors
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_QCOM_FASTRPC=m

# WCN7860 Wi-Fi 7 & Bluetooth
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PCI_PWRCTRL_PWRSEQ=m
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_MAC80211=m
CONFIG_ATH12K=m
CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS=y
CONFIG_BT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_LE=y
CONFIG_BT_AOSPEXT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_UHID=y

# Audio: AudioReach Q6APM, WCD939x SoundWire mics, quad AW88480 speaker amps
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_QDSP6_APM=m
CONFIG_SND_SOC_QDSP6_APM_DAI=m
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_WCD939X=m
CONFIG_SND_SOC_WCD939X_SDW=m
CONFIG_SND_SOC_AW88480=m

# Media: Iris hardware video codec, CAMSS dual cameras, PM8550 rear flash LED
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_PHY_QCOM_MIPI_CSI2=m
CONFIG_VIDEO_GC08A8=m
CONFIG_VIDEO_OV13B10=m
CONFIG_VIDEO_DW9807_VCM=m
CONFIG_V4L2_FLASH_LED_CLASS=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# Diagnostics, ramoops, suspend/lockup watchdogs
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_EXPERT=y
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=60
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=30
# CONFIG_RESET_SIMPLE is not set
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_BUDDY=y

# Hard boundary: NEVER enable OnePlus/Xiaomi board-specific drivers on TB378FC.
# CONFIG_DRM_PANEL_NOVATEK_NT36536 is not set
# CONFIG_BACKLIGHT_KTZ8866 is not set
# CONFIG_SND_SOC_AW88261 is not set
# CONFIG_KEYBOARD_ONEPLUS_POGO is not set
CONFIG_KEYBOARD_LENOVO_POGO=y
# CONFIG_CHARGER_SC8547A is not set
# CONFIG_CHARGER_ERHAI_PPS is not set
# CONFIG_CHARGER_CPS8601 is not set
# CONFIG_CHARGER_XIAOMI_MCA is not set
# CONFIG_VIDEO_SC1300CS is not set
# CONFIG_VIDEO_SC820CS is not set
# CONFIG_VIDEO_CN3927 is not set
# CONFIG_HID_XIAOMI is not set
