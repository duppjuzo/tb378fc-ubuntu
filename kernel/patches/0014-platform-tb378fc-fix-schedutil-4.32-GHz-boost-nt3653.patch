diff --git a/drivers/input/touchscreen/nt36536/nt36536.c b/drivers/input/touchscreen/nt36536/nt36536.c
index 83dd31a1f33..33b92dd81d1 100644
--- a/drivers/input/touchscreen/nt36536/nt36536.c
+++ b/drivers/input/touchscreen/nt36536/nt36536.c
@@ -1370,7 +1370,10 @@ __ATTRIBUTE_GROUPS(nvt_ts);
 
 static void nvt_resume_work(struct work_struct *work)
 {
-	struct nvt_ts_data *ts_core = container_of(work, struct nvt_ts_data, resume_work);
+	struct nvt_ts_data *ts_core = container_of(to_delayed_work(work),
+						   struct nvt_ts_data,
+						   resume_work);
+
 	nvt_ts_resume(&ts_core->client->dev);
 }
 
@@ -1445,7 +1448,7 @@ static void nvt_destroy_workqueues(struct nvt_ts_data *ts_core)
 {
 	/* Suspend/resume work can touch both firmware and ESD workqueues. */
 	if (ts_core->event_wq) {
-		cancel_work_sync(&ts_core->resume_work);
+		cancel_delayed_work_sync(&ts_core->resume_work);
 		destroy_workqueue(ts_core->event_wq);
 		ts_core->event_wq = NULL;
 	}
@@ -1600,7 +1603,7 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 		ret = -ENOMEM;
 		goto err_destroy_workqueues;
 	}
-	INIT_WORK(&ts->resume_work, nvt_resume_work);
+	INIT_DELAYED_WORK(&ts->resume_work, nvt_resume_work);
 
 	/*
 	 * Add the follower before any input device exists.  If the panel is
@@ -1785,7 +1788,7 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 		spin_unlock_irqrestore(&ts->lifecycle_lock, flags);
 
 		if (queue_resume)
-			queue_work(ts->event_wq, &ts->resume_work);
+			queue_delayed_work(ts->event_wq, &ts->resume_work, 0);
 	}
 
 	if (!ts->is_panel_follower) {
@@ -1858,6 +1861,7 @@ static void nvt_ts_remove(struct spi_device *client)
 	nvt_unregister_panel_follower(ts);
 	nvt_irq_enable(false);
 	nvt_destroy_workqueues(ts);
+	nvt_fw_cache_release();
 	if (ts->irq_requested) {
 		free_irq(client->irq, ts);
 		ts->irq_requested = false;
@@ -2042,9 +2046,11 @@ static int32_t nvt_ts_resume(struct device *dev)
 	 * The vendor core waits touchpanel,irq_need_dev_resume_time (500ms in
 	 * the stock dtsi) after resume before touching the IC, letting the
 	 * TDDI analog block (charge pump / AVDD) settle after the shared
-	 * panel reset.  Mirror that before the firmware download.
+	 * panel reset.  Mirror that before the initial firmware download;
+	 * deferred rootfs-mount retries already waited 500ms on event_wq.
 	 */
-	msleep(500);
+	if (!ts->fw_defer_retries)
+		msleep(500);
 
 	/*
 	 * The first prepare is the first time a follower may access the die;
@@ -2070,10 +2076,26 @@ static int32_t nvt_ts_resume(struct device *dev)
 		ret = nvt_update_firmware_no_eng_reset(ts->fw_name);
 	else
 		ret = nvt_update_firmware(ts->fw_name);
+	if (ret == -ENOENT && ts->fw_defer_retries < 30 &&
+	    (!ts->is_panel_follower || nvt_panel_is_on(ts))) {
+		ts->fw_defer_retries++;
+		nvt_set_touch_awake_state(ts, false);
+		ts->ic_state = NVT_IC_SUSPEND_OUT;
+		NVT_LOG("deferring firmware load (%u/30) until rootfs mounts\n",
+			ts->fw_defer_retries);
+		mutex_unlock(&ts->lock);
+		if (hold_wake)
+			pm_relax(dev);
+		if (ts->event_wq && (!ts->is_panel_follower || nvt_panel_is_on(ts)))
+			queue_delayed_work(ts->event_wq, &ts->resume_work,
+					   msecs_to_jiffies(500));
+		return -EAGAIN;
+	}
 	if (ret) {
 		NVT_ERR("download firmware failed: %d\n", ret);
 		goto resume_fail;
 	}
+	ts->fw_defer_retries = 0;
 
 	/*
 	 * No RESET_STATE_REK wait here: the vendor resume path considers the
@@ -2143,7 +2165,7 @@ static int32_t nvt_ts_resume(struct device *dev)
 static int nvt_pm_suspend(struct device *dev)
 {
 	/* Finish firmware I/O before the SPI controller suspends. */
-	flush_work(&ts->resume_work);
+	flush_delayed_work(&ts->resume_work);
 	if (READ_ONCE(ts->touch_awake) && !ts->db_wakeup)
 		nvt_ts_suspend(dev);
 
@@ -2168,7 +2190,7 @@ static int nvt_pm_resume(struct device *dev)
 
 	/* A panel that stayed prepared will not send another prepare callback. */
 	if (nvt_panel_resume_allowed(ts))
-		queue_work(ts->event_wq, &ts->resume_work);
+		queue_delayed_work(ts->event_wq, &ts->resume_work, 0);
 
 	return 0;
 }
@@ -2187,13 +2209,14 @@ static int panel_prepared(struct drm_panel_follower *follower)
 
 	spin_lock_irqsave(&ts->lifecycle_lock, flags);
 	ts->panel_on = true;
+	ts->fw_defer_retries = 0;
 	queue_resume = ts->resources_ready && !ts->stopping;
 	spin_unlock_irqrestore(&ts->lifecycle_lock, flags);
 
 	NVT_LOG("panel prepared\n");
 
 	if (queue_resume)
-		queue_work(ts->event_wq, &ts->resume_work);
+		queue_delayed_work(ts->event_wq, &ts->resume_work, 0);
 
 	return 0;
 }
@@ -2207,6 +2230,7 @@ static int panel_unpreparing(struct drm_panel_follower *follower)
 
 	spin_lock_irqsave(&ts->lifecycle_lock, flags);
 	ts->panel_on = false;
+	ts->fw_defer_retries = 0;
 	resources_ready = ts->resources_ready;
 	spin_unlock_irqrestore(&ts->lifecycle_lock, flags);
 
@@ -2214,7 +2238,7 @@ static int panel_unpreparing(struct drm_panel_follower *follower)
 
 	/* The callback is the barrier before the panel's physical reset. */
 	if (ts->event_wq)
-		cancel_work_sync(&ts->resume_work);
+		cancel_delayed_work_sync(&ts->resume_work);
 
 	if (!resources_ready)
 		return 0;
