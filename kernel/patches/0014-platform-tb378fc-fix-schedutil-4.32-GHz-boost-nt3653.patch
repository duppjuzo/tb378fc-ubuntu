 drivers/media/platform/qcom/camss/camss.c     |  8 +--
 drivers/power/supply/qcom_battmgr.c           |  1 +
 drivers/soundwire/qcom.c                      |  4 +-
 kernel/sched/cpufreq_schedutil.c              |  5 +-
 11 files changed, 169 insertions(+), 52 deletions(-)

