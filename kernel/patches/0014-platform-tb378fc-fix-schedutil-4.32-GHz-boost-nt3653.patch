-	bt_dev_info(hdev, "QCA Downloading %s", config->fwname);
-
-	ret = request_firmware(&fw, config->fwname, &hdev->dev);
+	if (quiet_missing) {
+		bt_dev_dbg(hdev, "QCA Probing %s", config->fwname);
+		ret = firmware_request_nowarn(&fw, config->fwname, &hdev->dev);
+	} else {
+		bt_dev_info(hdev, "QCA Downloading %s", config->fwname);
+		ret = request_firmware(&fw, config->fwname, &hdev->dev);
+	}
 	if (ret) {
 		/* If the board-specific file is missing, try loading the default
 		 * one, unless that was attempted already.
 		 */
 		if (config->type == TLV_TYPE_NVM &&
 		    qca_get_alt_nvm_file(config->fwname, sizeof(config->fwname))) {
-			bt_dev_info(hdev, "QCA Downloading %s", config->fwname);
-			ret = request_firmware(&fw, config->fwname, &hdev->dev);
+			if (quiet_missing) {
+				bt_dev_dbg(hdev, "QCA Probing %s", config->fwname);
+				ret = firmware_request_nowarn(&fw, config->fwname, &hdev->dev);
+			} else {
+				bt_dev_info(hdev, "QCA Downloading %s", config->fwname);
+				ret = request_firmware(&fw, config->fwname, &hdev->dev);
+			}
 			if (ret) {
-				bt_dev_err(hdev, "QCA Failed to request file: %s (%d)",
-					   config->fwname, ret);
+				if (!quiet_missing)
+					bt_dev_err(hdev, "QCA Failed to request file: %s (%d)",
+						   config->fwname, ret);
 				return ret;
 			}
 		} else {
-			bt_dev_err(hdev, "QCA Failed to request file: %s (%d)",
-				   config->fwname, ret);
+			if (!quiet_missing)
+				bt_dev_err(hdev, "QCA Failed to request file: %s (%d)",
+					   config->fwname, ret);
 			return ret;
 		}
 	}
+	if (quiet_missing)
+		bt_dev_info(hdev, "QCA Downloading %s", config->fwname);
 
 	size = fw->size;
 	data = vmalloc(fw->size);
@@ -636,6 +649,14 @@ static int qca_download_firmware(struct hci_dev *hdev,
 	return ret;
 }
 
+static int qca_download_firmware(struct hci_dev *hdev,
+				 struct qca_fw_config *config,
+				 enum qca_btsoc_type soc_type,
+				 u8 rom_ver)
+{
+	return qca_download_firmware_opt(hdev, config, soc_type, rom_ver, false);
+}
+
 static int qca_disable_soc_logging(struct hci_dev *hdev)
 {
 	struct sk_buff *skb;
@@ -839,7 +860,8 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 		}
 	}
 
-	err = qca_download_firmware(hdev, &config, soc_type, rom_ver);
+	err = qca_download_firmware_opt(hdev, &config, soc_type, rom_ver,
+					!rampatch_name && soc_type == QCA_WCN7860);
 	/* For WCN6750, if mbn file is not present then check for
 	 * tlv file.
 	 */
@@ -856,14 +878,10 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 			 "qca/hpbtfw%02x.tlv", rom_ver);
 		err = qca_download_firmware(hdev, &config, soc_type, rom_ver);
 	} else if (err < 0 && !rampatch_name && soc_type == QCA_WCN7860) {
-		bt_dev_dbg(hdev, "QCA Failed to request file: %s (%d)",
-			   config.fwname, err);
 		snprintf(config.fwname, sizeof(config.fwname),
 			 "qca/brhbtfw%02x.mbn", rom_ver);
-		err = qca_download_firmware(hdev, &config, soc_type, rom_ver);
