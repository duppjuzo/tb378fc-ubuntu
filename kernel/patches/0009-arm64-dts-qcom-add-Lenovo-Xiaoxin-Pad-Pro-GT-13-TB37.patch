+&tlmm {
+	/* Reserved GPIOs from stock DT: 36..39, 74. */
+	gpio-reserved-ranges = <36 4>, <74 1>;
+
+	panel_te: panel-te-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	tb378fc_touch_irq: tb378fc-touch-irq-state {
+		pins = "gpio162";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	tb378fc_wlan_en: wlan-enable-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-up;
+	};
+
+	tb378fc_wcd_reset: tb378fc-wcd-reset-state {
+		pins = "gpio101";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+
+	tb378fc_amp_resets: amp-resets-state {
+		pins = "gpio106", "gpio128", "gpio120", "gpio108";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	tb378fc_gpio_i2c: tb378fc-amp-i2c-state {
+		pins = "gpio52", "gpio53";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	tb378fc_sec_tdm: secondary-tdm-state {
+		sck-pins {
+			pins = "gpio121";
+			function = "i2s1_sck";
+			drive-strength = <8>;
+			bias-disable;
+		};
+		data0-pins {
+			pins = "gpio122";
+			function = "i2s1_data0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+		ws-pins {
+			pins = "gpio123";
+			function = "i2s1_ws";
+			drive-strength = <8>;
+			bias-disable;
+		};
+		data1-pins {
+			pins = "gpio124";
+			function = "i2s1_data1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+};
+
+&pm8550_gpios {
+	tb378fc_volume_up: volume-up-state {
+		pins = "gpio6";
+		function = "normal";
+		power-source = <1>;
+		input-enable;
+		bias-pull-up;
+	};
+};
+
+&pm8550ve_f_gpios {
+	tb378fc_bt_enable: bt-enable-state {
+		pins = "gpio3";
+		function = "normal";
+		power-source = <1>;
+		bias-disable;
+		input-disable;
+		output-enable;
+	};
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+&pm8550_flash {
+	status = "okay";
+
+	/* Native rear camera uses channels 1 + 4; conservative default-off limits. */
+	led-0 {
+		label = "white:flash:tb378fc";
+		function = LED_FUNCTION_FLASH;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <1>, <4>;
+		led-max-microamp = <100000>;
+		flash-max-microamp = <200000>;
+		flash-max-timeout-us = <200000>;
+		default-state = "off";
+	};
+};
+
+/* UFS internal storage */
+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l1j_ufs>;
+	vdda-pll-supply = <&vreg_l3g>;
+	status = "okay";
+};
+
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;
+	vcc-supply = <&vreg_l17b_ufs>;
+	vcc-max-microamp = <1300000>;
+	vccq-supply = <&vreg_l1d_ufs>;
+	vccq-max-microamp = <1200000>;
+	status = "okay";
