+
+/* ADSP & SoundWire WCD9390 */
+&remoteproc_adsp {
+	reg = <0x0 0x03000000 0x0 0x10000>;
+	firmware-name = "qcom/sm8750/tb378fc/adsp.mdt",
+			"qcom/sm8750/tb378fc/adsp_dtb.mdt";
+	status = "okay";
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd939x_rx: codec@0,4 {
+		compatible = "sdw20217010e00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5 9>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	/*
+	 * TB378FC WCD9390 TX transport timings at 19.2 MHz bus clock:
+	 * ADC1..ADC4 leave WCD9390 data port 1 onto master DP3 (lane 1,
+	 * offset 0, sample interval 3 -> 4.8 MHz), feeding SWR_MIC4..SWR_MIC7.
+	 */
+	qcom,ports-sinterval-low = /bits/ 8 <0x01 0x03 0x03 0x03>;
+	qcom,ports-offset1 = /bits/ 8 <0x00 0x02 0x00 0x02>;
+	qcom,ports-lane-control = /bits/ 8 <0x01 0x00 0x01 0x00>;
+
+	wcd939x_tx: codec@0,3 {
+		compatible = "sdw20217010e00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <3 4 3 4>;
+	};
+};
+
+#include "sm8750-lenovo-tb378fc-camera.dtsi"
