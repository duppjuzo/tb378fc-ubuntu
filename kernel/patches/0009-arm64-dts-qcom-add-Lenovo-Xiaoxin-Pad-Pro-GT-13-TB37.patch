+	};
+
+	regulators-4 {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "i";
+		vdd-s7-supply = <&vph_pwr>;
+		vdd-l1-supply = <&vreg_s7i>;
+		vdd-l3-supply = <&vreg_s1d>;
+
+		vreg_s7i: smps7 {
