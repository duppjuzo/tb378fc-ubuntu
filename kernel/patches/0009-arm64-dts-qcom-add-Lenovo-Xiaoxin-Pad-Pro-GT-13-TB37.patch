From 3ea65d4370b50973197e20cb2c8b2cbcc334fa55 Mon Sep 17 00:00:00 2001
From: TB378FC Maintainer <maintainer@tb378fc.local>
Date: Sun, 22 Nov 2026 01:04:44 +0800
Subject: [PATCH] arm64: dts: qcom: add Lenovo Xiaoxin Pad Pro GT 13 (TB378FC)

Add the unified Linux 7.4 devicetree for Lenovo Xiaoxin Pad Pro GT 13
(TB378FC), integrating display, touch, UFS, quad AW88480 speakers,
WCD9390 SoundWire mic/USBSS, WCN7860 Wi-Fi/BT, Iris VPU, PM8550 flash,
dual CAMSS cameras on standalone CSI-2 PHYs, SM8750P 118C passive CPU
thermal zones, ABL root identity restore, and 8GB-safe ramoops.

Signed-off-by: TB378FC Maintainer <maintainer@tb378fc.local>
---
 arch/arm64/boot/dts/qcom/Makefile             |    1 +
 .../qcom/sm8750-lenovo-tb378fc-camera.dtsi    |  228 +++
 .../boot/dts/qcom/sm8750-lenovo-tb378fc.dts   | 1566 +++++++++++++++++
 3 files changed, 1795 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc-camera.dtsi
 create mode 100644 arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 1beaeb54edf..679ee591d90 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -454,6 +454,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm8650-mtp.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8650-qrd.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8650-valve-deckard.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8750-erhai.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8750-lenovo-tb378fc.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8750-mtp.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8750-qrd.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8750-xiaomi-piano-desktop.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc-camera.dtsi b/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc-camera.dtsi
new file mode 100644
index 00000000000..09206a0317d
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc-camera.dtsi
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Lenovo TB378FC dual camera subsystem (GC08A8 front + OV13B10 rear),
+ * wired onto the Linux 7.4 SM8750 standalone CSI-2 PHY graph.
+ */
+
+#include <dt-bindings/clock/qcom,sm8750-cambistmclkcc.h>
+#include <dt-bindings/clock/qcom,sm8750-camcc.h>
+
+&tlmm {
+	tb378fc_cam_front: tb378fc-cam-front-state {
+		reset-pins {
+			pins = "gpio7";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		mclk-pins {
+			pins = "gpio93";
+			function = "cam_aon_mclk4";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
+	tb378fc_cam_rear: tb378fc-cam-rear-state {
+		reset-pins {
+			pins = "gpio11";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		mclk-pins {
+			pins = "gpio92";
+			function = "cam_mclk";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
+	tb378fc_cam_cci0: tb378fc-cam-cci0-state {
+		scl-pins {
+			pins = "gpio114";
+			function = "cci_i2c_scl";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		sda-pins {
+			pins = "gpio113";
+			function = "cci_i2c_sda";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	tb378fc_cam_cci1: tb378fc-cam-cci1-state {
+		scl-pins {
+			pins = "gpio118";
+			function = "cci_i2c_scl";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		sda-pins {
+			pins = "gpio117";
+			function = "cci_i2c_sda";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+};
+
+/* Rear camera OV13B10 on CCI0 bus 0 -> CSIPHY5 */
+&cci0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&tb378fc_cam_cci0>;
+	/delete-property/ pinctrl-1;
+	assigned-clocks = <&camcc CAM_CC_CCI_0_CLK>;
+	assigned-clock-rates = <37500000>;
+	status = "okay";
+};
+
+&cci0_i2c0 {
+	clock-frequency = <400000>;
+
+	vcm: lens@c {
+		compatible = "dongwoon,dw9807-vcm";
+		reg = <0x0c>;
+		vdd-supply = <&vreg_l16b_cam>;
+		dongwoon,focus-range = <0 400>;
+	};
+
+	camera@36 {
+		compatible = "lenovo,tb378fc-ov13b10", "ovti,ov13b10";
+		reg = <0x36>;
+		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK3_CLK>;
+		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK3_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
+		reset-gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_cam_rear>;
+		dovdd-supply = <&vreg_l10b_cam>;
+		avdd-supply = <&vreg_l8b_cam>;
+		dvdd-supply = <&vreg_l11b_cam>;
+		vaf-supply = <&vreg_l16b_cam>;
+		lens-focus = <&vcm>;
+		orientation = <1>;
+		rotation = <90>;
+
+		port {
+			cam_rear_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <560000000>;
+				remote-endpoint = <&csiphy5_in>;
+			};
+		};
+	};
+};
+
+&cci0_i2c1 {
+	status = "disabled";
+};
+
+/* Front camera GC08A8 on CCI1 bus 0 -> CSIPHY1 */
+&cci1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&tb378fc_cam_cci1>;
+	/delete-property/ pinctrl-1;
+	assigned-clocks = <&camcc CAM_CC_CCI_1_CLK>;
+	assigned-clock-rates = <37500000>;
+	status = "okay";
+};
+
+&cci1_i2c0 {
+	clock-frequency = <400000>;
+
+	camera@31 {
+		compatible = "galaxycore,gc08a8";
+		reg = <0x31>;
+		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
+		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
+		assigned-clock-rates = <19200000>;
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
+		reset-gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_cam_front>;
+		dovdd-supply = <&vreg_l10b_cam>;
+		avdd-supply = <&vreg_l7b_cam>;
+		dvdd-supply = <&vreg_l1i_cam>;
+		orientation = <0>;
+		rotation = <270>;
+
+		port {
+			cam_front_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <336000000>;
+				remote-endpoint = <&csiphy1_in>;
+			};
+		};
+	};
+};
+
+&cci1_i2c1 {
+	status = "disabled";
+};
+
+&camss {
+	status = "okay";
+
+	ports {
+		/delete-node/ port@0;
+		/delete-node/ port@2;
+		/delete-node/ port@3;
+		/delete-node/ port@4;
+	};
+};
+
+&csiphy0_out {
+	/delete-property/ remote-endpoint;
+};
+
+&csiphy2_out {
+	/delete-property/ remote-endpoint;
+};
+
+&csiphy3_out {
+	/delete-property/ remote-endpoint;
+};
+
+&csiphy4_out {
+	/delete-property/ remote-endpoint;
+};
+
+&csiphy1 {
+	vdda-0p9-supply = <&vreg_l1f_0p88>;
+	vdda-1p2-supply = <&vreg_l3g>;
+	status = "okay";
+};
+
+&csiphy1_in {
+	bus-type = <4>;
+	data-lanes = <1 2 3 4>;
+	remote-endpoint = <&cam_front_ep>;
+};
+
+&csiphy5 {
+	vdda-0p9-supply = <&vreg_l1f_0p88>;
+	vdda-1p2-supply = <&vreg_l3g>;
+	status = "okay";
+};
+
+&csiphy5_in {
+	bus-type = <4>;
+	data-lanes = <1 2 3 4>;
+	remote-endpoint = <&cam_rear_ep>;
+};
+
+&camss_csiphy1_in {
+	data-lanes = <1 2 3 4>;
+};
+
+&camss_csiphy5_in {
+	data-lanes = <1 2 3 4>;
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc.dts b/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc.dts
new file mode 100644
index 00000000000..57cc49a17da
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8750-lenovo-tb378fc.dts
@@ -0,0 +1,1566 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Lenovo Xiaoxin Pad Pro GT 13 (TB378FC) - Qualcomm SM8750P mainline board DTS.
+ *
+ * Unified board definition for Linux 7.4+ (sm8750/v7.4-dev), integrating:
+ *  - Display: CSOT NT36526 3504x2190 dual-DSI/DSC panel, paired bias, dual AW99706B
+ *  - Touch: Novatek NT36536 SPI TDDI (rising-edge IRQ, inverted X + swapped XY)
+ *  - Storage: Built-in UFS PHY/HBA and RPMH rails (no runtime DT overlay)
+ *  - Audio: Quad AW88480 speaker amps on GPIO-I2C + WCD9390 SoundWire mic/codec
+ *  - Connectivity: WCN7860 PCIe Wi-Fi 7 + UART14 Bluetooth
+ *  - USB-C: Dual-role USB3 + DisplayPort Alt Mode + WCD9390 USBSS + PMIC GLINK
+ *  - Media: Iris hardware video codec + PM8550 rear flash LED + dual CAMSS cameras
+ *  - Thermal & Diagnostics: SM8750P 118C passive CPU throttling + 8GB-safe ramoops
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
+#include "sm8750.dtsi"
+#include "pm8550.dtsi"
+#define PMK8550VE_SID 8
+#include "pm8550ve.dtsi"
+#include "pmih0108.dtsi"
+#include "pmk8550.dtsi"
+#include "sm8750-pmics.dtsi"
+
+/delete-node/ &cpusys_vm_mem;
+
+/ {
+	model = "Lenovo Xiaoxin Pad Pro GT 13 (TB378FC)";
+	compatible = "lenovo,tb378fc", "qcom,sm8750";
+	/* Restored before core initcalls by CONFIG_QCOM_ABL_ROOT_IDENTITY after ABL DTBO. */
+	qcom,mainline-model = "Lenovo Xiaoxin Pad Pro GT 13 (TB378FC)";
+	qcom,mainline-compatible = "lenovo,tb378fc", "qcom,sm8750";
+	chassis-type = "tablet";
+
+	/* Lenovo ABL updates this existing node before entering the kernel. */
+	chosen {
+	};
+
+	reserved-memory {
+		/* Preserve UEFI active scanout across SMMU handover. */
+		tb378fc_splash: splash_region@fc800000 {
+			label = "cont_splash_region";
+			reg = <0x0 0xfc800000 0x0 0x2b00000>;
+			no-map;
+			iommu-addresses = <&mdss 0x0 0xfc800000 0x0 0x2b00000>;
+		};
+
+		/*
+		 * Verified 8GB-unit-safe 4 MiB ramoops region inside the unreserved
+		 * 0xb81c0000..0xd4e23000 physical gap, matching stock downstream RAM
+		 * console allocation with oops/panic dmesg capture enabled.
+		 */
+		ramoops@c2000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xc2000000 0x0 0x400000>;
+			record-size = <0x20000>;
+			console-size = <0x1e0000>;
+			pmsg-size = <0x200000>;
+		};
+	};
+
+	clocks {
+		xo_board: xo-board {
+			compatible = "fixed-clock";
+			clock-frequency = <76800000>;
+			#clock-cells = <0>;
+		};
+
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		bi_tcxo_div2: bi-tcxo-div2-clk {
+			compatible = "fixed-factor-clock";
+			#clock-cells = <0>;
+			clocks = <&rpmhcc RPMH_CXO_CLK>;
+			clock-mult = <1>;
+			clock-div = <2>;
+		};
+
+		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
+			compatible = "fixed-factor-clock";
+			#clock-cells = <0>;
+			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
+			clock-mult = <1>;
+			clock-div = <2>;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_volume_up>;
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	pmic-glink {
+		compatible = "lenovo,tb378fc-pmic-glink",
+			     "qcom,sm8750-pmic-glink",
+			     "qcom,sm8550-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_dp_qmpphy_out>;
+					};
+				};
+
+				port@2 {
+					reg = <2>;
+
+					pmic_glink_sbu: endpoint {
+						remote-endpoint = <&usb_sbu_mux>;
+					};
+				};
+			};
+		};
+	};
+
+	wcn7860-pmu {
+		compatible = "qcom,wcn7860-pmu";
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_wlan_en>, <&tb378fc_bt_enable>;
+
+		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&vreg_l3f_1p8>;
+		vddio1p2-supply = <&vreg_l2f_1p2>;
+		vddaon-supply = <&vreg_s4d_0p85>;
+		vdddig-supply = <&vreg_s5f_0p85>;
+		vddrfa1p2-supply = <&vreg_s7i>;
+		vddrfa1p8-supply = <&vreg_s3g>;
+
+		clocks = <&rpmhcc RPMH_RF_CLK1>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+			vreg_pmu_rfa_1p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p8";
+			};
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+
+	wcd939x: tb378fc-wcd939x {
+		compatible = "qcom,wcd9390-codec";
+		#sound-dai-cells = <1>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_wcd_reset>;
+		reset-gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;
+		vdd-rxtx-supply = <&vreg_l15b>;
+		vdd-io-supply = <&vreg_l15b>;
+		vdd-buck-supply = <&vreg_l15b>;
+		vdd-px-supply = <&vreg_l15b>;
+		vdd-mic-bias-supply = <&vreg_bob1>;
+		qcom,micbias1-microvolt = <1800000>;
+		qcom,micbias2-microvolt = <1800000>;
+		qcom,micbias3-microvolt = <1800000>;
+		qcom,micbias4-microvolt = <1800000>;
+		qcom,rx-device = <&wcd939x_rx>;
+		qcom,tx-device = <&wcd939x_tx>;
+	};
+
+	tb378fc_amp_bus: i2c-amp {
+		compatible = "i2c-gpio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		sda-gpios = <&tlmm 52 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 53 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <5>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_gpio_i2c>, <&tb378fc_amp_resets>;
+
+		spk_amp1: amplifier@34 {
+			compatible = "awinic,aw88480";
+			reg = <0x34>;
+			#sound-dai-cells = <0>;
+			sound-name-prefix = "Amp1";
+			awinic,audio-channel = <1>;
+			reset-gpios = <&tlmm 106 GPIO_ACTIVE_LOW>;
+			firmware-name = "awinic/tb378fc/aw88480-native-music.acf";
+		};
+
+		spk_amp0: amplifier@35 {
+			compatible = "awinic,aw88480";
+			reg = <0x35>;
+			#sound-dai-cells = <0>;
+			sound-name-prefix = "Amp0";
+			awinic,audio-channel = <0>;
+			reset-gpios = <&tlmm 128 GPIO_ACTIVE_LOW>;
+			firmware-name = "awinic/tb378fc/aw88480-native-music.acf";
+		};
+
+		spk_amp2: amplifier@36 {
+			compatible = "awinic,aw88480";
+			reg = <0x36>;
+			#sound-dai-cells = <0>;
+			sound-name-prefix = "Amp2";
+			awinic,audio-channel = <2>;
+			reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+			firmware-name = "awinic/tb378fc/aw88480-native-music.acf";
+		};
+
+		spk_amp3: amplifier@37 {
+			compatible = "awinic,aw88480";
+			reg = <0x37>;
+			#sound-dai-cells = <0>;
+			sound-name-prefix = "Amp3";
+			awinic,audio-channel = <3>;
+			reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
+			firmware-name = "awinic/tb378fc/aw88480-native-music.acf";
+		};
+	};
+
+	sound {
+		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
+		model = "Lenovo-TB378FC";
+		widgets = "Speaker", "Speakers";
+		audio-routing = "Speakers", "Amp0 OUT",
+				"Speakers", "Amp1 OUT",
+				"Speakers", "Amp2 OUT",
+				"Speakers", "Amp3 OUT",
+				"AMIC1", "MIC BIAS1",
+				"AMIC4", "MIC BIAS4",
+				"TX SWR_INPUT4", "ADC1_OUTPUT",
+				"TX SWR_INPUT6", "ADC3_OUTPUT";
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_sec_tdm>;
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+			convert-rate = <48000>;
+			convert-channels = <2>;
