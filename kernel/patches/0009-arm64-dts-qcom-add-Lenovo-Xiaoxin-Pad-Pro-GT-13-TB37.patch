+
+/* QUPv3 wrappers and DMA */
+&qupv3_1 {
+	status = "okay";
+};
+
+&gpi_dma1 {
+	status = "okay";
+};
+
+&qupv3_2 {
+	status = "okay";
+};
+
+&gpi_dma2 {
+	status = "okay";
+};
+
+/* Never let hardware I2C5 claim gpio52/53 owned by tb378fc-amp-i2c. */
+&i2c5 {
+	status = "disabled";
+};
+
+/* WCD9390 USB-C SBU switch for DP Alt Mode */
+&i2c3 {
+	status = "okay";
+
+	typec-mux@e {
+		compatible = "qcom,wcd9390-usbss";
+		reg = <0x0e>;
+		vdd-supply = <&vreg_l15b>;
+		mode-switch;
+		orientation-switch;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				usb_sbu_mux: endpoint {
+					remote-endpoint = <&pmic_glink_sbu>;
+				};
+			};
+		};
+	};
+};
+
+/* Dual AW99706B backlight secondary bus + primary bus & LCD bias */
+&i2c8 {
+	status = "okay";
+	clock-frequency = <400000>;
+};
+
+&i2c10 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	panel_bias: regulator@3e {
+		compatible = "lenovo,tb378fc-panel-bias";
+		reg = <0x3e>;
+		regulator-name = "tb378fc-panel-bias";
+		positive-gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>;
+		negative-gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
+	};
+
+	panel_backlight: backlight@76 {
+		compatible = "lenovo,tb378fc-aw99706b";
+		reg = <0x76>;
+		enable-gpios = <&tlmm 88 GPIO_ACTIVE_HIGH>;
+		lenovo,secondary-i2c-bus = <&i2c8>;
+	};
+};
+
+/* Novatek NT36536 SPI touchscreen */
+&spi4 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "lenovo,tb378fc-nvt";
+		reg = <0>;
+		spi-max-frequency = <9600000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&tb378fc_touch_irq>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <162 IRQ_TYPE_EDGE_RISING>;
+		panel = <&panel>;
+		touchscreen-size-x = <2190>;
+		touchscreen-size-y = <3504>;
+		touchscreen-x-mm = <175>;
+		touchscreen-y-mm = <280>;
+		touchscreen-inverted-x;
+		touchscreen-swapped-x-y;
+		firmware-name = "novatek/tb378fc.bin";
+		novatek,pen-support;
+	};
+};
+
+/* WCN7860 Bluetooth UART */
+&uart14 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&qup_uart14_default>, <&qup_uart14_cts_rts>;
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn7860-bt";
+		max-speed = <3200000>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddbtcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddbtcmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p9-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p3-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p9-supply = <&vreg_pmu_rfa_1p8>;
+	};
+};
+
+/* WCN7860 PCIe Wi-Fi */
+&pcie0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_default_state>;
+	status = "okay";
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l1f_0p88>;
+	vdda-pll-supply = <&vreg_l3g>;
+	status = "okay";
