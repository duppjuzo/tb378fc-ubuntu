From fc00e2847b295d730dc3a1a0f7946e68eb0dfb9b Mon Sep 17 00:00:00 2001
From: TB378FC Maintainer <maintainer@tb378fc.local>
Date: Thu, 26 Nov 2026 12:22:48 +0800
Subject: [PATCH] tty: serial: qcom_geni_serial: deassert tx-en on M_CMD_DONE
 in DMA mode

In DMA mode, TX_DMA_DONE fires as soon as DMA finishes pushing data into
the GENI TX FIFO while the UART transmitter is still shifting bytes out
onto the wire. Deasserting half-duplex tx-en-gpios on TX_DMA_DONE cuts
off host-to-MCU frames mid-flight at 921600 baud.

Enable M_CMD_DONE_EN when tx-en-gpios is present and only deassert tx-en
after M_CMD_DONE_EN fires with no active DMA/main command remaining.

Signed-off-by: TB378FC Maintainer <maintainer@tb378fc.local>
---
 drivers/tty/serial/qcom_geni_serial.c | 30 ++++++++++++++++++++++++---
 1 file changed, 27 insertions(+), 3 deletions(-)

diff --git a/drivers/tty/serial/qcom_geni_serial.c b/drivers/tty/serial/qcom_geni_serial.c
index 7084615d37f..fb3d0963a54 100644
--- a/drivers/tty/serial/qcom_geni_serial.c
+++ b/drivers/tty/serial/qcom_geni_serial.c
@@ -838,6 +838,13 @@ static void qcom_geni_serial_stop_tx_dma(struct uart_port *uport)
 		port->tx_dma_addr = 0;
 	}
 
+	if (port->tx_en_gpio) {
+		u32 irq_en = readl(uport->membase + SE_GENI_M_IRQ_EN);
+
+		if (irq_en & M_CMD_DONE_EN)
+			writel(irq_en & ~M_CMD_DONE_EN,
+			       uport->membase + SE_GENI_M_IRQ_EN);
+	}
 	qcom_geni_set_tx_en(port, false);
 }
 
@@ -863,6 +870,15 @@ static void qcom_geni_serial_start_tx_dma(struct uart_port *uport)
 	qcom_geni_set_rs485_mode(uport, SER_RS485_RTS_ON_SEND);
 	qcom_geni_set_tx_en(port, true);
 
+	if (port->tx_en_gpio) {
+		u32 irq_en = readl(uport->membase + SE_GENI_M_IRQ_EN);
+
+		writel(M_CMD_DONE_EN, uport->membase + SE_GENI_M_IRQ_CLEAR);
+		if (!(irq_en & M_CMD_DONE_EN))
+			writel(irq_en | M_CMD_DONE_EN,
+			       uport->membase + SE_GENI_M_IRQ_EN);
+	}
+
 	qcom_geni_serial_setup_tx(uport, xmit_size);
 
 	ret = geni_se_tx_dma_prep(&port->se, tail, xmit_size,
@@ -1279,10 +1295,18 @@ static irqreturn_t qcom_geni_serial_isr(int isr, void *dev)
 	if (dma) {
 		if (dma_tx_status & TX_DMA_DONE) {
 			qcom_geni_serial_handle_tx_dma(uport);
-			if (!port->tx_dma_addr) {
-				qcom_geni_set_tx_en(port, false);
+			if (!port->tx_dma_addr && !port->tx_en_gpio)
 				qcom_geni_set_rs485_mode(uport, SER_RS485_RTS_AFTER_SEND);
-			}
+		}
+		if (port->tx_en_gpio && (m_irq_status & M_CMD_DONE_EN) &&
+		    !port->tx_dma_addr && !qcom_geni_serial_main_active(uport)) {
+			u32 cur_en = readl(uport->membase + SE_GENI_M_IRQ_EN);
+
+			if (cur_en & M_CMD_DONE_EN)
+				writel(cur_en & ~M_CMD_DONE_EN,
+				       uport->membase + SE_GENI_M_IRQ_EN);
+			qcom_geni_set_tx_en(port, false);
+			qcom_geni_set_rs485_mode(uport, SER_RS485_RTS_AFTER_SEND);
 		}
 	} else if (m_irq_status & m_irq_en &
 		   (M_TX_FIFO_WATERMARK_EN | M_CMD_DONE_EN)) {
