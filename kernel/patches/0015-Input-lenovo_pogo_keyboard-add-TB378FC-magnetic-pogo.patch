+			ret = dev_err_probe(&pdev->dev, PTR_ERR(port->tx_en_gpio),
+					    "Failed to get tx-en GPIO\n");
+			goto error;
+		}
+		of_property_read_u32(pdev->dev.of_node, "qcom,tx-en-delay-us",
+				     &port->tx_en_delay_us);
+		if (port->tx_en_delay_us > 10000)
+			port->tx_en_delay_us = 10000;
+	}
+
 	port->private_data.drv = drv;
 	uport->private_data = &port->private_data;
 	init_irq_work(&port->tx_kick, qcom_geni_serial_restart_tx);
