--- /dev/null
+++ b/Documentation/devicetree/bindings/input/lenovo,tb378fc-pogo-keyboard.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/lenovo,tb378fc-pogo-keyboard.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Lenovo TB378FC Magnetic Pogo-Pin Keyboard and Touchpad
+
+maintainers:
+  - TB378FC Maintainers <tb378fc@localhost>
+
+description:
+  Magnetic pogo-pin keyboard and multitouch clickpad folio attached over a
+  half-duplex UART serial bus on the Lenovo Xiaoxin Pad Pro GT 13 (TB378FC).
+
+allOf:
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: lenovo,tb378fc-pogo-keyboard
+
+  power-en-gpios:
+    maxItems: 1
+    description: GPIO enabling 5V/VCC power to the magnetic pogo connector.
+
+  plug-gpios:
+    maxItems: 1
+    description: Active-low Hall/plug detect GPIO indicating keyboard attachment.
+
+  uart-wake-gpios:
+    maxItems: 1
+    description: Active-low wakeup interrupt GPIO asserted by the keyboard MCU.
+
+  panel:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Display panel phandle used to synchronize MCU sleep with screen state.
+
+required:
+  - compatible
+  - power-en-gpios
+  - plug-gpios
+  - uart-wake-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    serial {
+        keyboard {
+            compatible = "lenovo,tb378fc-pogo-keyboard";
+            power-en-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
+            plug-gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
+            uart-wake-gpios = <&tlmm 87 GPIO_ACTIVE_LOW>;
+            panel = <&panel>;
+        };
+    };
+...
