+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Lenovo TB378FC (Xiaoxin Pad Pro GT 13) Magnetic Pogo-Pin Keyboard & Touchpad
+ *
+ * Clean-room serdev driver derived from hardware protocol analysis of the
+ * stock TB378FC UART Pogo keyboard controller on QUPv3 SE2 (921600 8N1).
+ */
+
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/gpio/consumer.h>
+#include <linux/input.h>
