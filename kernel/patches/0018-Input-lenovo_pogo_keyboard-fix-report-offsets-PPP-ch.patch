From 2f76607a94d01e007bb102c28099aa5e9b53770d Mon Sep 17 00:00:00 2001
From: TB378FC Maintainer <maintainer@tb378fc.local>
Date: Thu, 26 Nov 2026 12:11:59 +0800
Subject: [PATCH] Input: lenovo_pogo_keyboard: fix report offsets, PPP
 checksum, touchpad, and keymaps

Fix three protocol and keymap bugs in the TB378FC pogo keyboard driver:

- Skip the leading plain[0] command opcode byte in lenovo_kb_report_kbd(),
  lenovo_kb_report_cuskey(), and lenovo_kb_report_touchpad() so keyboard
  modifiers/keycodes, consumer usages, and multitouch touchpad frames parse
  at their true offsets instead of dropping 1/2-finger touchpad reports and
  corrupting modifiers/keys.
- Compute the 8-bit PPP frame checksum over escaped wire bytes (0x7d->0xda,
  0x7e->0xdb) in lenovo_ppp_encode() and lenovo_ppp_decode() to match the
  keyboard MCU firmware.
- Expand lenovo_hid_keymap to 256 entries, map Lenovo 0x038e..0x039d custom
  keys to standard Linux keycodes, and remove conflicting BTN_RIGHT from
  the clickpad device while adding INPUT_MT_DROP_UNUSED.

Signed-off-by: TB378FC Maintainer <maintainer@tb378fc.local>
---
 drivers/input/keyboard/lenovo_pogo_keyboard.c | 144 ++++++++++--------
 1 file changed, 83 insertions(+), 61 deletions(-)

diff --git a/drivers/input/keyboard/lenovo_pogo_keyboard.c b/drivers/input/keyboard/lenovo_pogo_keyboard.c
index 25cfee780df..1ef32d46bb1 100644
--- a/drivers/input/keyboard/lenovo_pogo_keyboard.c
+++ b/drivers/input/keyboard/lenovo_pogo_keyboard.c
@@ -105,7 +105,7 @@ static const u8 lenovo_scram_dict[64] = {
 };
 
 /* USB HID Keyboard/Keypad usage page (0x07) -> Linux keycodes */
-static const u8 lenovo_hid_keymap[224] = {
+static const u8 lenovo_hid_keymap[256] = {
 	  0,   0,   0,   0,  30,  48,  46,  32,
 	 18,  33,  34,  35,  23,  36,  37,  38,
 	 50,  49,  24,  25,  16,  19,  31,  20,
@@ -134,6 +134,10 @@ static const u8 lenovo_hid_keymap[224] = {
 	240, 240, 240, 240, 240, 240, 240, 240,
 	240, 240, 240, 240, 240, 240, 240, 240,
 	111, 240, 240, 240, 240, 240, 240, 240,
+	 29,  42,  56, 125,  97,  54, 100, 126,
+	164, 166, 165, 163, 161, 115, 114, 113,
+	150, 158, 159, 128, 136, 177, 178, 176,
+	142, 152, 173, 140, 240, 240, 240, 240,
 };
 
 static const u8 lenovo_hid_modifiers[8] = {
@@ -160,20 +164,20 @@ static const struct lenovo_cuskey_entry lenovo_cuskeys[] = {
 	{ 0x0224, KEY_BACK,		0x000c0224 },
 	{ 0x0070, KEY_BRIGHTNESSDOWN,	0x000c0070 },
 	{ 0x006f, KEY_BRIGHTNESSUP,	0x000c006f },
-	{ 0x038e, KEY_UNKNOWN,		0x000c038e },
-	{ 0x0390, KEY_UNKNOWN,		0x000c0390 },
-	{ 0x0391, KEY_UNKNOWN,		0x000c0391 },
-	{ 0x0392, KEY_UNKNOWN,		0x000c0392 },
-	{ 0x0393, KEY_UNKNOWN,		0x000c0393 },
-	{ 0x0394, KEY_UNKNOWN,		0x000c0394 },
-	{ 0x0395, KEY_UNKNOWN,		0x000c0395 },
-	{ 0x0397, KEY_UNKNOWN,		0x000c0397 },
-	{ 0x0398, KEY_UNKNOWN,		0x000c0398 },
-	{ 0x0399, KEY_UNKNOWN,		0x000c0399 },
-	{ 0x039a, KEY_UNKNOWN,		0x000c039a },
-	{ 0x039b, KEY_UNKNOWN,		0x000c039b },
-	{ 0x039c, KEY_UNKNOWN,		0x000c039c },
-	{ 0x039d, KEY_UNKNOWN,		0x000c039d },
+	{ 0x038e, KEY_SCREENLOCK,	0x000c038e },
+	{ 0x0390, KEY_LANGUAGE,		0x000c0390 },
+	{ 0x0391, KEY_MICMUTE,		0x000c0391 },
+	{ 0x0392, KEY_TOUCHPAD_TOGGLE,	0x000c0392 },
+	{ 0x0393, KEY_SEARCH,		0x000c0393 },
+	{ 0x0394, KEY_FULL_SCREEN,	0x000c0394 },
+	{ 0x0395, KEY_SCALE,		0x000c0395 },
+	{ 0x0397, KEY_SWITCHVIDEOMODE,	0x000c0397 },
+	{ 0x0398, KEY_PROG1,		0x000c0398 },
+	{ 0x0399, KEY_PROG2,		0x000c0399 },
+	{ 0x039a, KEY_FN_ESC,		0x000c039a },
+	{ 0x039b, KEY_CONFIG,		0x000c039b },
+	{ 0x039c, KEY_PROG4,		0x000c039c },
+	{ 0x039d, KEY_PROG3,		0x000c039d },
 };
 
 enum ppp_rx_state {
@@ -256,13 +260,19 @@ static void lenovo_disscram(u8 *out, const u8 *in, size_t len, u8 key_idx)
 		out[i] = in[i] ^ lenovo_scram_dict[(key_idx + i) & 0x3f];
 }
 
-static size_t lenovo_ppp_append_escaped(u8 *dst, size_t pos, u8 byte)
+static size_t lenovo_ppp_append_escaped(u8 *dst, size_t pos, u8 byte, u8 *csum)
 {
 	if (byte == PPP_ESC || byte == PPP_FLAG) {
+		u8 esc_b = byte ^ PPP_ESC_XOR;
+
 		dst[pos++] = PPP_ESC;
-		dst[pos++] = byte ^ PPP_ESC_XOR;
+		dst[pos++] = esc_b;
+		if (csum)
+			*csum += (u8)(PPP_ESC + esc_b);
 	} else {
 		dst[pos++] = byte;
+		if (csum)
+			*csum += byte;
 	}
 	return pos;
 }
@@ -283,15 +293,12 @@ static int lenovo_ppp_encode(const u8 *payload, size_t len, u8 key_idx,
 	out[pos++] = PPP_FLAG;
 	out[pos++] = PPP_ADDR;
 
-	csum += key_idx;
-	pos = lenovo_ppp_append_escaped(out, pos, key_idx);
+	pos = lenovo_ppp_append_escaped(out, pos, key_idx, &csum);
 
-	for (i = 0; i < len; i++) {
-		csum += payload[i];
-		pos = lenovo_ppp_append_escaped(out, pos, payload[i]);
-	}
+	for (i = 0; i < len; i++)
+		pos = lenovo_ppp_append_escaped(out, pos, payload[i], &csum);
 
-	pos = lenovo_ppp_append_escaped(out, pos, csum);
+	pos = lenovo_ppp_append_escaped(out, pos, csum, NULL);
 	out[pos++] = PPP_FLAG;
 
 	return pos;
@@ -301,6 +308,7 @@ static int lenovo_ppp_decode(const u8 *frame, size_t frame_len,
 			     u8 *out_plain, size_t out_max)
 {
 	u8 unesc[LENOVO_KB_MAX_RAW_LEN];
+	u8 wire_contrib[LENOVO_KB_MAX_RAW_LEN];
 	size_t i, ulen = 0;
 	bool esc = false;
 	u8 sum = 0;
@@ -311,17 +319,25 @@ static int lenovo_ppp_decode(const u8 *frame, size_t frame_len,
 
 	for (i = 2; i < frame_len - 1; i++) {
 		u8 b = frame[i];
+		u8 w;
 
 		if (esc) {
+			if (b != (PPP_ESC ^ PPP_ESC_XOR) &&
+			    b != (PPP_FLAG ^ PPP_ESC_XOR))
+				return -EPROTO;
+			w = (u8)(PPP_ESC + b);
 			b ^= PPP_ESC_XOR;
 			esc = false;
 		} else if (b == PPP_ESC) {
 			esc = true;
 			continue;
+		} else {
+			w = b;
 		}
 
 		if (ulen >= sizeof(unesc))
 			return -EMSGSIZE;
+		wire_contrib[ulen] = w;
 		unesc[ulen++] = b;
 	}
 
@@ -329,7 +345,7 @@ static int lenovo_ppp_decode(const u8 *frame, size_t frame_len,
 		return -EPROTO;
 
 	for (i = 0; i < ulen - 1; i++)
-		sum += unesc[i];
+		sum += wire_contrib[i];
 
 	if (sum != unesc[ulen - 1])
 		return -EBADMSG;
@@ -505,21 +521,31 @@ static void lenovo_kb_report_kbd(struct lenovo_pogo_kb *kb, const u8 *pkt,
 				 size_t len)
 {
 	struct input_dev *kdev = kb->kb_dev;
+	const u8 *rep;
 	int i, j;
 
-	if (!kdev || len < 8)
+	/* pkt[0]=0x11, pkt[1]=len(0x08), pkt[2..9]=8-byte HID boot report */
+	if (!kdev || len < 10)
 		return;
 
-	/* Modifiers in pkt[1] */
+	rep = &pkt[2];
+
+	/* Ignore HID ErrorRollOver (0x01) packets to preserve key state */
+	for (i = 2; i < 8; i++) {
+		if (rep[i] == 0x01)
+			return;
+	}
+
+	/* Modifiers in rep[0] */
 	for (i = 0; i < 8; i++) {
-		bool old_v = (kb->prev_kbd[1] >> i) & 1;
-		bool new_v = (pkt[1] >> i) & 1;
+		bool old_v = (kb->prev_kbd[0] >> i) & 1;
+		bool new_v = (rep[0] >> i) & 1;
 
 		if (old_v != new_v)
 			input_report_key(kdev, lenovo_hid_modifiers[i], new_v);
 	}
 
-	/* Released keys (present in prev_kbd[2..7], absent in pkt[2..7]) */
+	/* Released keys (present in prev_kbd[2..7], absent in rep[2..7]) */
 	for (i = 2; i < 8; i++) {
 		u8 code = kb->prev_kbd[i];
 		bool found = false;
@@ -528,7 +554,7 @@ static void lenovo_kb_report_kbd(struct lenovo_pogo_kb *kb, const u8 *pkt,
 			continue;
 
 		for (j = 2; j < 8; j++) {
-			if (pkt[j] == code) {
+			if (rep[j] == code) {
 				found = true;
 				break;
 			}
@@ -541,9 +567,9 @@ static void lenovo_kb_report_kbd(struct lenovo_pogo_kb *kb, const u8 *pkt,
 		}
 	}
 
-	/* Pressed keys (present in pkt[2..7], absent in prev_kbd[2..7]) */
+	/* Pressed keys (present in rep[2..7], absent in prev_kbd[2..7]) */
 	for (i = 2; i < 8; i++) {
-		u8 code = pkt[i];
+		u8 code = rep[i];
 		bool found = false;
 
 		if (code <= 3)
@@ -564,7 +590,7 @@ static void lenovo_kb_report_kbd(struct lenovo_pogo_kb *kb, const u8 *pkt,
 	}
 
 	input_sync(kdev);
-	memcpy(kb->prev_kbd, pkt, 8);
+	memcpy(kb->prev_kbd, rep, 8);
 }
 
 static void lenovo_kb_emit_cuskey(struct input_dev *kdev, u16 usage, int pressed)
@@ -592,11 +618,12 @@ static void lenovo_kb_report_cuskey(struct lenovo_pogo_kb *kb, const u8 *pkt,
 	u16 cur[2];
 	int i, j;
 
-	if (!kdev || len < 5)
+	/* pkt[0]=0x12, pkt[1]=len(0x04), pkt[2..5]=two le16 consumer usages */
+	if (!kdev || len < 6)
 		return;
 
-	cur[0] = pkt[1] | (pkt[2] << 8);
-	cur[1] = pkt[3] | (pkt[4] << 8);
+	cur[0] = pkt[2] | (pkt[3] << 8);
+	cur[1] = pkt[4] | (pkt[5] << 8);
 
 	/* Releases */
 	for (i = 0; i < 2; i++) {
@@ -641,30 +668,31 @@ static void lenovo_kb_report_touchpad(struct lenovo_pogo_kb *kb, const u8 *pkt,
 				      size_t len)
 {
 	struct input_dev *tdev = kb->tp_dev;
-	size_t expected_len;
+	size_t data_len;
 	int nfingers, i;
-	int active_count = 0;
-	u8 btns;
+	u8 len_byte, btns;
 
-	if (!tdev || len < 2)
+	/* pkt[0]=0x13, pkt[1]=len(1+5*N), pkt[2]=btns, pkt[3..]=N*5 finger data */
+	if (!tdev || len < 3)
 		return;
 
-	nfingers = (pkt[0] >= 6) ? (pkt[0] - 1) / 5 : 0;
+	len_byte = pkt[1];
+	nfingers = (len_byte >= 6) ? (len_byte - 1) / 5 : 0;
 	if (nfingers > LENOVO_TP_MAX_SLOTS)
 		nfingers = LENOVO_TP_MAX_SLOTS;
 
-	expected_len = 2 + (size_t)nfingers * 5;
-	if (expected_len > len || expected_len > sizeof(kb->prev_tp))
+	data_len = 2 + (size_t)nfingers * 5;
+	if (1 + data_len > len || data_len > sizeof(kb->prev_tp))
 		return;
 
-	if (memcmp(kb->prev_tp, pkt, expected_len) == 0)
+	if (memcmp(kb->prev_tp, &pkt[1], data_len) == 0)
 		return;
 
-	memcpy(kb->prev_tp, pkt, expected_len);
-	btns = pkt[1];
+	memcpy(kb->prev_tp, &pkt[1], data_len);
+	btns = pkt[2];
 
 	for (i = 0; i < nfingers; i++) {
-		const u8 *f = &pkt[2 + i * 5];
+		const u8 *f = &pkt[3 + i * 5];
 		u8 status = f[0];
 		int slot = status >> 4;
 		bool down = !!(status & BIT(0));
@@ -677,24 +705,19 @@ static void lenovo_kb_report_touchpad(struct lenovo_pogo_kb *kb, const u8 *pkt,
 
 		input_mt_slot(tdev, slot);
 		if (!down) {
+			if (!valid_finger)
+				input_mt_report_slot_state(tdev, MT_TOOL_PALM, true);
+			input_mt_report_slot_state(tdev, MT_TOOL_FINGER, false);
+		} else {
 			input_mt_report_slot_state(tdev,
 						   valid_finger ? MT_TOOL_FINGER : MT_TOOL_PALM,
-						   false);
-		} else {
-			if (!valid_finger) {
-				input_mt_report_slot_state(tdev, MT_TOOL_PALM, true);
-			} else {
-				input_mt_report_slot_state(tdev, MT_TOOL_FINGER, true);
-				active_count++;
-			}
+						   true);
 			input_report_abs(tdev, ABS_MT_POSITION_X, x);
 			input_report_abs(tdev, ABS_MT_POSITION_Y, y);
 		}
 	}
 
-	(void)active_count;
-	input_report_key(tdev, BTN_LEFT, !!(btns & BIT(0)));
-	input_report_key(tdev, BTN_RIGHT, !!(btns & BIT(1)));
+	input_report_key(tdev, BTN_LEFT, !!(btns & (BIT(0) | BIT(1))));
 	input_mt_sync_frame(tdev);
 	input_sync(tdev);
 }
@@ -900,7 +923,6 @@ static int lenovo_kb_register_inputs(struct lenovo_pogo_kb *kb)
 		__set_bit(EV_KEY, tdev->evbit);
 		__set_bit(EV_ABS, tdev->evbit);
 		__set_bit(BTN_LEFT, tdev->keybit);
-		__set_bit(BTN_RIGHT, tdev->keybit);
 		__set_bit(BTN_TOUCH, tdev->keybit);
 		__set_bit(INPUT_PROP_BUTTONPAD, tdev->propbit);
 
@@ -918,7 +940,7 @@ static int lenovo_kb_register_inputs(struct lenovo_pogo_kb *kb)
 		input_abs_set_res(tdev, ABS_MT_POSITION_Y, 32);
 
 		ret = input_mt_init_slots(tdev, LENOVO_TP_MAX_SLOTS,
-					  INPUT_MT_POINTER);
+					  INPUT_MT_POINTER | INPUT_MT_DROP_UNUSED);
 		if (ret) {
 			input_free_device(tdev);
 			return ret;
-- 
