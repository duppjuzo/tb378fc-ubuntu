 }
 
+bool msm_dsi_can_dfps(struct msm_dsi *msm_dsi,
+		      const struct drm_display_mode *old_mode,
+		      const struct drm_display_mode *new_mode)
+{
+	if (!msm_dsi || !msm_dsi->host)
+		return false;
+
+	return msm_dsi_host_can_dfps(msm_dsi->host,
+				     msm_dsi_is_bonded_dsi(msm_dsi),
+				     old_mode, new_mode);
+}
+
+void msm_dsi_dfps_timing_update(struct msm_dsi *msm_dsi,
+				const struct drm_display_mode *mode)
+{
+	if (!msm_dsi || !msm_dsi->host)
+		return;
+
+	msm_dsi_host_dfps_timing_update(msm_dsi->host,
+					msm_dsi_is_bonded_dsi(msm_dsi), mode);
+}
