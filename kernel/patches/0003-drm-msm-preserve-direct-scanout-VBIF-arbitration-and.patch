+/* Preserve firmware's active scanout direct-mapped regions across attach. */
+static int msm_iommu_map_direct_regions(struct iommu_domain *domain,
+					struct device *dev)
+{
+	struct iommu_resv_region *region;
+	LIST_HEAD(regions);
+	int ret = 0;
