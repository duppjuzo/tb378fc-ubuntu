diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index a58ca12ad27..437341a12a9 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1484,10 +1484,26 @@ static int dsi_cmd_dma_tx(struct msm_dsi_host *msm_host, int len)
 		ret = wait_for_completion_timeout(&msm_host->dma_comp,
 					msecs_to_jiffies(200));
 		DBG("ret=%d", ret);
-		if (ret == 0)
+		if (ret == 0) {
+			DRM_DEV_ERROR(&msm_host->pdev->dev,
+				      "DSI cmd DMA timeout id=%d enabled=%d ctrl=%08x status=%08x intr=%08x fifo=%08x lane=%08x trig=%08x dma=%08x base=%08x len=%08x phyerr=%08x to=%08x clk=%08x\n",
