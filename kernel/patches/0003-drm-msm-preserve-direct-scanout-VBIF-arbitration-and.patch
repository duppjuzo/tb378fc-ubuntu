@@ -2402,6 +2418,15 @@ void msm_dsi_host_cmd_xfer_commit(struct mipi_dsi_host *host, u32 dma_base,
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 
+	/* Native DSI 6G v2.8+ command DMA VBIF arbitration priority. */
+	if (msm_dsi_host_version_geq(msm_host, MSM_DSI_VER_MAJOR_6G,
+				     MSM_DSI_6G_VER_MINOR_V2_8_0)) {
+		u32 vbif = dsi_read(msm_host, REG_DSI_VBIF_CTRL);
+
+		if ((vbif & 0x7) != 0x7)
+			dsi_write(msm_host, REG_DSI_VBIF_CTRL, vbif | 0x7);
+	}
+
 	dsi_write(msm_host, REG_DSI_DMA_BASE, dma_base);
 	dsi_write(msm_host, REG_DSI_DMA_LEN, len);
 	dsi_write(msm_host, REG_DSI_TRIG_DMA, 1);
@@ -2668,6 +2693,95 @@ int msm_dsi_host_power_off(struct mipi_dsi_host *host)
 	return 0;
 }
 
+bool msm_dsi_host_can_dfps(struct mipi_dsi_host *host, bool is_bonded_dsi,
+			   const struct drm_display_mode *old_mode,
+			   const struct drm_display_mode *new_mode)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	unsigned long old_pclk, new_pclk, delta;
+
+	if (!msm_host || !msm_host->enabled || !msm_host->ctrl_base)
+		return false;
+	if (!(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO))
+		return false;
+	if (!msm_dsi_host_version_geq(msm_host, MSM_DSI_VER_MAJOR_6G,
+				      MSM_DSI_6G_VER_MINOR_V2_8_0))
+		return false;
+	if (!(dsi_read(msm_host, REG_DSI_CTRL) & DSI_CTRL_ENABLE))
+		return false;
+	if (old_mode->hdisplay != new_mode->hdisplay ||
+	    old_mode->vdisplay != new_mode->vdisplay ||
+	    old_mode->flags != new_mode->flags ||
+	    drm_mode_equal(old_mode, new_mode))
+		return false;
+
+	/*
+	 * Seamless video-mode timing updates reuse the running DSI PHY PLL
+	 * and pixel/byte clocks without teardown. Require the compressed link
+	 * clock of the two modes to match within 0.5%.
+	 */
+	old_pclk = dsi_get_pclk_rate(old_mode, msm_host->dsc, is_bonded_dsi);
+	new_pclk = dsi_get_pclk_rate(new_mode, msm_host->dsc, is_bonded_dsi);
+	if (!old_pclk || !new_pclk)
+		return false;
+	delta = old_pclk > new_pclk ? old_pclk - new_pclk : new_pclk - old_pclk;
+	return delta * 200 <= old_pclk;
+}
+
+void msm_dsi_host_dfps_timing_update(struct mipi_dsi_host *host,
+				     bool is_bonded_dsi,
+				     const struct drm_display_mode *mode)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 h_total = mode->htotal;
+	u32 v_total = mode->vtotal;
+	u32 hs_end = mode->hsync_end - mode->hsync_start;
+	u32 vs_end = mode->vsync_end - mode->vsync_start;
+	u32 ha_start = h_total - mode->hsync_start;
+	u32 ha_end = ha_start + mode->hdisplay;
+	u32 va_start = v_total - mode->vsync_start;
+	u32 va_end = va_start + mode->vdisplay;
+	u32 hdisplay = mode->hdisplay;
+	bool wide_bus_enabled = msm_dsi_host_is_wide_bus_enabled(host);
+
+	msm_dsi_host_set_display_mode(host, mode);
+
+	if (is_bonded_dsi) {
+		h_total /= 2;
+		hs_end /= 2;
+		ha_start /= 2;
+		ha_end /= 2;
+		hdisplay /= 2;
+	}
+
+	if (msm_host->dsc) {
+		u32 bits_per_pclk = wide_bus_enabled ?
+			msm_host->dsc->bits_per_component * 3 : 24;
+
+		h_total -= hdisplay;
+		hdisplay = DIV_ROUND_UP(msm_dsc_get_bytes_per_line(msm_host->dsc) * 8,
+					bits_per_pclk);
+		h_total += hdisplay;
+		ha_end = ha_start + hdisplay;
+	}
+
+	dsi_write(msm_host, REG_DSI_TIMING_DB_MODE, 1);
+	dsi_write(msm_host, REG_DSI_ACTIVE_H,
+		  DSI_ACTIVE_H_START(ha_start) | DSI_ACTIVE_H_END(ha_end));
+	dsi_write(msm_host, REG_DSI_ACTIVE_V,
+		  DSI_ACTIVE_V_START(va_start) | DSI_ACTIVE_V_END(va_end));
+	dsi_write(msm_host, REG_DSI_TOTAL,
+		  DSI_TOTAL_H_TOTAL(h_total - 1) | DSI_TOTAL_V_TOTAL(v_total - 1));
+	dsi_write(msm_host, REG_DSI_ACTIVE_HSYNC,
+		  DSI_ACTIVE_HSYNC_START(0) | DSI_ACTIVE_HSYNC_END(hs_end));
+	dsi_write(msm_host, REG_DSI_ACTIVE_VSYNC_HPOS, 0);
+	dsi_write(msm_host, REG_DSI_ACTIVE_VSYNC_VPOS,
+		  DSI_ACTIVE_VSYNC_VPOS_START(0) | DSI_ACTIVE_VSYNC_VPOS_END(vs_end));
+	/* Ensure all timing register updates are visible before TIMING_FLUSH */
+	wmb();
+	dsi_write(msm_host, REG_DSI_TIMING_FLUSH, 1);
+}
