From 71b554d7b3a0f04f61a19d5c22643556b45a7b3e Mon Sep 17 00:00:00 2001
From: TB378FC Maintainer <maintainer@tb378fc.local>
Date: Sat, 21 Nov 2026 00:48:48 +0800
Subject: [PATCH] drm/msm: preserve direct scanout, VBIF arbitration, and
 native seamless DFPS

1. Preserve UEFI direct-mapped splash regions across SMMU attach and
   choose the largest free 32-bit KMS IOVA aperture.
2. Program DSI 6G v2.8+ VBIF_CTRL command DMA arbitration and dump
   controller state on DMA timeouts.
3. Implement native in-tree seamless video-mode DFPS (TIMING_DB_MODE +
   TIMING_FLUSH + DPU INTF timing update) for matching-clock refresh
   switches (60/90/120/144Hz), eliminating out-of-tree struct-prefix hooks.

Signed-off-by: TB378FC Maintainer <maintainer@tb378fc.local>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c      |  56 +++++++++
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h      |   1 +
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c   |  68 ++++++++++
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.h   |   5 +
 drivers/gpu/drm/msm/dsi/dsi.c                 |  22 ++++
 drivers/gpu/drm/msm/dsi/dsi.h                 |   6 +
 drivers/gpu/drm/msm/dsi/dsi_host.c            | 118 +++++++++++++++++-
 drivers/gpu/drm/msm/msm_drv.h                 |  15 +++
 drivers/gpu/drm/msm/msm_iommu.c               |  29 +++++
 drivers/gpu/drm/msm/msm_kms.c                 |  47 ++++++-
 drivers/gpu/drm/msm/registers/display/dsi.xml |   3 +
 11 files changed, 366 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index e3f4590c8df..44be699210a 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -1038,6 +1038,19 @@ static void dpu_crtc_atomic_flush(struct drm_crtc *crtc,
 		dpu_plane_flush(plane);
 	}
 
+	if (cstate->seamless_dfps && !crtc->state->mode_changed) {
+		struct drm_encoder *enc;
+
+		drm_for_each_encoder_mask(enc, dev, crtc->state->encoder_mask)
+			dpu_encoder_seamless_dfps_commit(enc, &crtc->state->adjusted_mode);
+		drm_calc_timestamping_constants(crtc, &crtc->state->adjusted_mode);
+		drm_dbg_kms(dev, "crtc%d: seamless DFPS switch to %dHz (%ux%u)\n",
+			    crtc->base.id,
+			    drm_mode_vrefresh(&crtc->state->adjusted_mode),
+			    crtc->state->adjusted_mode.htotal,
+			    crtc->state->adjusted_mode.vtotal);
+	}
+
 	/* Kickoff will be scheduled by outer layer */
 }
 
@@ -1212,6 +1225,7 @@ static struct drm_crtc_state *dpu_crtc_duplicate_state(struct drm_crtc *crtc)
 
 	/* duplicate base helper */
 	__drm_atomic_helper_crtc_duplicate_state(crtc, &cstate->base);
+	cstate->seamless_dfps = false;
 
 	return &cstate->base;
 }
@@ -1650,6 +1664,48 @@ static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 		return rc;
 	}
 
+	/*
+	 * Promote eligible same-topology video-mode DSI refresh-rate switches
+	 * to seamless double-buffered DFPS, avoiding full panel/PHY teardown.
+	 */
+	if (crtc_state->mode_changed && !crtc_state->active_changed &&
+	    !crtc_state->connectors_changed && !crtc_state->color_mgmt_changed) {
+		struct drm_crtc_state *old_crtc_state =
+			drm_atomic_get_old_crtc_state(state, crtc);
+
+		if (old_crtc_state && old_crtc_state->enable && old_crtc_state->active &&
+		    old_crtc_state->encoder_mask == crtc_state->encoder_mask &&
+		    hweight32(crtc_state->encoder_mask) == 1) {
+			struct dpu_crtc_state *old_cstate = to_dpu_crtc_state(old_crtc_state);
+			bool same_topology = old_cstate->num_mixers == cstate->num_mixers &&
+					     old_cstate->num_ctls == cstate->num_ctls;
+			u32 i;
+
+			for (i = 0; same_topology && i < old_cstate->num_mixers; i++) {
+				if (old_cstate->mixers[i].hw_lm != cstate->mixers[i].hw_lm ||
+				    old_cstate->mixers[i].lm_ctl != cstate->mixers[i].lm_ctl ||
+				    old_cstate->mixers[i].hw_dspp != cstate->mixers[i].hw_dspp)
+					same_topology = false;
+			}
+			for (i = 0; same_topology && i < old_cstate->num_ctls; i++) {
+				if (old_cstate->hw_ctls[i] != cstate->hw_ctls[i])
+					same_topology = false;
+			}
+			if (same_topology) {
+				struct drm_encoder *enc;
+
+				drm_for_each_encoder_mask(enc, crtc->dev, crtc_state->encoder_mask) {
+					if (dpu_encoder_can_seamless_dfps(enc,
+							&old_crtc_state->adjusted_mode,
+							&crtc_state->adjusted_mode)) {
+						cstate->seamless_dfps = true;
+						crtc_state->mode_changed = false;
+					}
+				}
+			}
+		}
+	}
+
 	return 0;
 }
 
