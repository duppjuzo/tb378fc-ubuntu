diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index e62d636be35..c153603c903 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -3029,6 +3029,74 @@ unsigned int dpu_encoder_helper_get_cwb_mask(struct dpu_encoder_phys *phys_enc)
  *   used for this encoder.
  * @phys_enc: Pointer to physical encoder structure
  */
+bool dpu_encoder_can_seamless_dfps(struct drm_encoder *drm_enc,
+				   const struct drm_display_mode *old_mode,
+				   const struct drm_display_mode *new_mode)
+{
+	struct msm_drm_private *priv;
+	struct dpu_encoder_virt *dpu_enc;
+	unsigned int i;
+
+	if (!drm_enc || !old_mode || !new_mode)
+		return false;
+
+	priv = drm_enc->dev->dev_private;
+	dpu_enc = to_dpu_encoder_virt(drm_enc);
+	if (!dpu_enc->enabled || dpu_enc->disp_info.intf_type != INTF_DSI ||
+	    !dpu_enc->num_phys_encs || !dpu_enc->cur_master ||
+	    !dpu_enc->disp_info.num_of_h_tiles)
+		return false;
+
+	for (i = 0; i < dpu_enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = dpu_enc->phys_encs[i];
+
+		if (!phys || phys->parent != drm_enc || !phys->hw_intf ||
+		    !phys->hw_ctl || phys->hw_intf->cap->type != INTF_DSI ||
+		    phys->enable_state != DPU_ENC_ENABLED || !phys->ops.enable ||
+		    !drm_mode_equal(&phys->cached_mode, old_mode))
+			return false;
+	}
+
+	for (i = 0; i < dpu_enc->disp_info.num_of_h_tiles; i++) {
+		u32 dsi_idx = dpu_enc->disp_info.h_tile_instance[i];
+
+		if (dsi_idx >= ARRAY_SIZE(priv->kms->dsi) ||
+		    !msm_dsi_can_dfps(priv->kms->dsi[dsi_idx], old_mode, new_mode))
+			return false;
+	}
+
+	return true;
+}
+
+void dpu_encoder_seamless_dfps_commit(struct drm_encoder *drm_enc,
+				      const struct drm_display_mode *mode)
+{
+	struct msm_drm_private *priv = drm_enc->dev->dev_private;
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	unsigned int i;
+
+	/* Update DSI timing engine(s) with double-buffered flush (clock master first). */
+	for (i = 0; i < dpu_enc->disp_info.num_of_h_tiles; i++) {
+		u32 dsi_idx = dpu_enc->disp_info.h_tile_instance[i];
+
+		if (dsi_idx < ARRAY_SIZE(priv->kms->dsi))
+			msm_dsi_dfps_timing_update(priv->kms->dsi[dsi_idx], mode);
+	}
+
+	/*
+	 * Reprogram DPU INTF timing registers on already-enabled physical
+	 * encoders. ops.enable() keeps enable_state == DPU_ENC_ENABLED and
+	 * queues the pending INTF flush to join the regular atomic kickoff.
+	 */
+	for (i = 0; i < dpu_enc->num_phys_encs; i++)
+		dpu_enc->phys_encs[i]->cached_mode = *mode;
+
+	if (dpu_enc->cur_slave && dpu_enc->cur_slave->ops.enable)
+		dpu_enc->cur_slave->ops.enable(dpu_enc->cur_slave);
+	if (dpu_enc->cur_master && dpu_enc->cur_master->ops.enable)
+		dpu_enc->cur_master->ops.enable(dpu_enc->cur_master);
+}
+
 unsigned int dpu_encoder_helper_get_dsc(struct dpu_encoder_phys *phys_enc)
 {
 	struct drm_encoder *encoder = phys_enc->parent;
