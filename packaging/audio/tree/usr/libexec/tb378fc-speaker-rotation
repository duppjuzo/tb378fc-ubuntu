#!/usr/bin/python3
# SPDX-License-Identifier: MIT
'''Map stereo/quad playback to Lenovo TB378FC's four speaker positions as GNOME rotates.

Event-driven on org.gnome.Mutter.DisplayConfig MonitorsChanged without spawning
a persistent `pw-dump --monitor` stream, and keeps the smart-filter input node
at unity volume (1.0) so WirePlumber never leaves hidden attenuation on it.
'''
import json
import os
from pathlib import Path
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS = "org.gnome.Mutter.DisplayConfig"
PATH = "/org/gnome/Mutter/DisplayConfig"
IFACE = "org.gnome.Mutter.DisplayConfig"
# +1.6 dB makeup gain compensating for the 560 Hz / 4.2 kHz enclosure EQ notches
MATRIX_GAIN = 1.20


class SpeakerRotation:
    def __init__(self, config):
        self.config = config
        self.connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.proxy = Gio.DBusProxy.new_sync(
            self.connection, Gio.DBusProxyFlags.NONE, None, BUS, PATH, IFACE, None
        )
        self.last_transform = None
        self.last_node = None
        self.retry_attempts = 0
        self.connection.signal_subscribe(
            BUS, IFACE, "MonitorsChanged", PATH, None,
            Gio.DBusSignalFlags.NONE, self.on_monitors_changed, None
        )

    def on_monitors_changed(self, *_args):
        self.update()

    def internal_transform(self):
        reply = self.proxy.call_sync(
            "GetCurrentState", None, Gio.DBusCallFlags.NONE, 5000, None
        )
        _serial, monitors, logical_monitors, _properties = reply.unpack()
        builtins = set()
        for monitor in monitors:
            spec, _modes, properties = monitor
            connector = spec[0]
            if properties.get("is-builtin", False):
                builtins.add(connector)
        for logical in logical_monitors:
            transform = logical[3]
            physical = logical[5]
            if any(monitor[0] in builtins for monitor in physical):
                return int(transform) & 3
        raise RuntimeError("Mutter reports no built-in display")

    def set_matrix(self, transform):
        route = tuple(self.config["routes"][str(transform * 90)])
        params = []
        names = self.config["mixer_nodes"]
        for name, source in zip(names, route):
            for channel in range(4):
                params.extend((f"{name}:Gain {channel + 1}",
                               MATRIX_GAIN if source == channel else 0.0))
        target = self.config["control_node"]
        dump = subprocess.run(
            ["pw-dump", target],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        nodes = json.loads(dump.stdout)
        node = next(
            obj for obj in nodes
            if obj.get("type", "").endswith(":Node")
            and obj.get("info", {}).get("props", {}).get("node.name") == target
        )
        node_id = node["id"]
        identity = (node_id, node["info"]["props"].get("object.serial"))

        # Always keep the hidden filter.smart node at unity 1.0 channelVolumes
        # so GNOME's volume slider on HiFi__Speaker__sink has full dynamic range.
        subprocess.run(
            ["wpctl", "set-mute", str(node_id), "0"],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
        )
        subprocess.run(
            ["wpctl", "set-volume", str(node_id), "1.0"],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
        )
        subprocess.run(
            [
                "pw-cli",
                "set-param",
                str(node_id),
                "Props",
                json.dumps({"params": params}, separators=(",", ":")),
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=5,
        )
        self.last_node = identity
        self.last_transform = transform

    def retry(self):
        self.retry_attempts += 1
        if self.update():
            self.retry_attempts = 0
            return False
        return self.retry_attempts < 30

    def publish_transform(self, transform):
        rdir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.geteuid()}"
        target = Path(rdir) / "tb378fc-display-transform"
        tmp = Path(rdir) / "tb378fc-display-transform.tmp"
        try:
            tmp.write_text(f"{int(transform) & 3}\n", encoding="utf-8")
            os.chmod(tmp, 0o644)
            tmp.replace(target)
        except OSError:
            pass

    def update(self):
        try:
            tf = self.internal_transform()
            self.publish_transform(tf)
            self.set_matrix(tf)
            return True
        except Exception as exc:
            print(f"speaker-rotation deferred: {exc}", file=sys.stderr, flush=True)
            return False


def main():
    config_path = (
        sys.argv[1]
        if len(sys.argv) > 1
        else "/usr/share/tb378fc-audio/speaker-rotation/config.json"
    )
    with open(config_path, encoding="utf-8") as handle:
        config = json.load(handle)
    daemon = SpeakerRotation(config)
    if not daemon.update():
        GLib.timeout_add(500, daemon.retry)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
