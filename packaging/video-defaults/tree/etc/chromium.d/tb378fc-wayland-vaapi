# Enable native Wayland (Ozone + zwp_text_input_v3 IME/OSK) and Qualcomm Iris VA-API hardware video decode & encode on TB378FC.
export CHROMIUM_FLAGS="${CHROMIUM_FLAGS:-} --ozone-platform-hint=auto --enable-wayland-ime --wayland-text-input-version=3 --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,VaapiVideoDecodeLinuxGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks"
