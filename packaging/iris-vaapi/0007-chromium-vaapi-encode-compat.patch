+void test_chromium_sticky_rate_control()
+{
+    auto cbr = iris::codec::make_h264_encoder(VAProfileH264ConstrainedBaseline, RateMode::Cbr);
+    VAEncSequenceParameterBufferH264 seq = h264_sequence();
+    seq.bits_per_second = 0; // Chromium passes bitrate via VAEncMiscParameterRateControl on IDR only
+    VAEncPictureParameterBufferH264 pic = h264_picture();
+    pic.CurrPic.picture_id = 0x1001;
+    pic.pic_fields.bits.idr_pic_flag = 1;
+
+    VAEncMiscParameterRateControl rc = {};
+    rc.bits_per_second = 2500000;
+    std::vector<uint32_t> rc_buf = misc(VAEncMiscParameterTypeRateControl, rc);
+    const iris::EncodeParams idr_out = cbr->translate(h264_input(seq, pic, { rc_buf.data() }));
+    check(idr_out.bitrate == 2500000 && idr_out.peak_bitrate == 2500000, "Chromium IDR CBR bitrate");
+
+    // Subsequent P-frame omits VAEncMiscParameterRateControl; cached bitrate must survive
+    pic.pic_fields.bits.idr_pic_flag = 0;
+    pic.CurrPic.picture_id = 0x1002;
+    VAEncSliceParameterBufferH264 p_slice = h264_slice(seq, false, 0x1001);
+    EncodePicture p_in = h264_input(seq, pic, {});
+    p_in.slices = { &p_slice };
+    const iris::EncodeParams p_out = cbr->translate(p_in);
+    check(p_out.bitrate == 2500000 && p_out.peak_bitrate == 2500000, "Chromium P-frame sticky CBR bitrate");
+
+    auto vbr = iris::codec::make_h264_encoder(VAProfileH264High, RateMode::Vbr);
+    rc.bits_per_second = 4000000;
+    rc.target_percentage = 75;
+    std::vector<uint32_t> vbr_buf = misc(VAEncMiscParameterTypeRateControl, rc);
+    const iris::EncodeParams vbr_out = vbr->translate(h264_input(seq, h264_picture(), { vbr_buf.data() }));
+    check(vbr_out.bitrate == 3000000 && vbr_out.peak_bitrate == 4000000, "VBR target_percentage scaling");
+}
+
