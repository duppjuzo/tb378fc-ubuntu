[Unit]
Description=Orient only the TB378FC native volume buttons with GNOME (standalone fallback)
After=display-manager.service tb378fc-thermal-guard.service
ConditionPathExists=!/run/tb378fc-system-consolidated

[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/tb378fc-volume-orientation
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
