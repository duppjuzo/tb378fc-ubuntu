[Unit]
Description=Lenovo TB378FC Post-Rootfs DSP, Touchscreen, and Wi-Fi 7 Initialization
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Before=sound.target bluetooth.target NetworkManager.service gdm.service multi-user.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tb378fc-hw-init

[Install]
WantedBy=multi-user.target
