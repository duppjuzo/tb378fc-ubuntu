[Unit]
Description=TB378FC native torch with automatic off
ConditionPathExists=/sys/class/leds/white:flash:tb378fc/brightness

[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/tb378fc-torch-service.py
ExecStopPost=/bin/sh -c 'if [ -w /sys/class/leds/white:flash:tb378fc/brightness ]; then echo 0 > /sys/class/leds/white:flash:tb378fc/brightness; echo 0 > /sys/class/leds/white:flash:tb378fc/flash_strobe; fi'
TimeoutStopSec=2
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
