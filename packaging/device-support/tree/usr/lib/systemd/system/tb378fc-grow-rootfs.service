[Unit]
Description=Expand TB378FC Ubuntu ext4 root filesystem to full partition capacity
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target
ConditionPathExists=!/var/lib/tb378fc-rootfs-grown

[Service]
Type=oneshot
ExecStart=/bin/sh -eu -c 'root_dev=$(findmnt -n -o SOURCE /); [ -b "$root_dev" ] && resize2fs "$root_dev"; mkdir -p /var/lib; touch /var/lib/tb378fc-rootfs-grown'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
