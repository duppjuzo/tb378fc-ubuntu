#!/bin/sh
# Select the independently validated Turnip Vulkan ICD for one application.
set -eu
icd=""
for candidate in \
    /usr/lib/tb378fc/mesa/share/vulkan/icd.d/freedreno_icd.aarch64.json \
    /usr/lib/tb378fc/turnip/share/vulkan/icd.d/freedreno_icd.aarch64.json; do
    if [ -r "$candidate" ]; then
        icd="$candidate"
        break
    fi
done
if [ -z "$icd" ]; then
    printf '%s\n' 'tb378fc-vulkan: Turnip ICD manifest not found under /usr/lib/tb378fc/{mesa,turnip}' >&2
    exit 1
fi
if [ "$#" -eq 0 ]; then
    printf '%s\n' 'Usage: tb378fc-vulkan APPLICATION [ARGUMENTS...]' >&2
    exit 2
fi
export VK_DRIVER_FILES="$icd"
export VK_ICD_FILENAMES="$icd"
exec "$@"
