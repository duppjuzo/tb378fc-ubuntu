#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Replace the placeholder WLAN MAC with a deterministic local MAC before NM starts."""
import hashlib
from pathlib import Path
import secrets
import subprocess
import time

PLACEHOLDER_MAC = '00:03:7f:12:34:56'


def local_mac():
    try:
        serial = Path('/sys/devices/soc0/serial_number').read_bytes().strip()
        if serial and serial not in (b'0', b'00000000'):
            suffix = hashlib.sha256(b'TB378FC Linux WLAN address v1\0' + serial).digest()[:5]
            return '02:' + ':'.join(f'{b:02x}' for b in suffix)
    except OSError:
        pass
    return '02:' + ':'.join(f'{x:02x}' for x in secrets.token_bytes(5))


def main():
    interfaces = []
    for _ in range(40):
        interfaces = [p for p in Path('/sys/class/net').iterdir() if (p / 'wireless').is_dir()]
        if interfaces:
            break
        time.sleep(0.25)
    if not interfaces:
        print('NO_WLAN_INTERFACE_FOUND')
        return
    for device in interfaces:
        try:
            vendor = (device / 'device/vendor').read_text().strip()
            prod = (device / 'device/device').read_text().strip()
            addr = (device / 'address').read_text().strip().lower()
        except OSError:
            continue
        if vendor != '0x17cb' or prod != '0x110e':
            continue
        if addr == PLACEHOLDER_MAC:
            address = local_mac()
            subprocess.run(['ip', 'link', 'set', device.name, 'down'], check=True)
            subprocess.run(['ip', 'link', 'set', device.name, 'address', address], check=True)
            subprocess.run(['ip', 'link', 'set', device.name, 'up'], check=True)
            print(f'LOCAL_WLAN_ADDRESS_ASSIGNED {device.name}')
        else:
            print(f'EXISTING_UNIQUE_WLAN_ADDRESS_PRESERVED {device.name}')


if __name__ == '__main__':
    main()
