#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Early boot initramfs for Lenovo Xiaoxin Pad Pro GT 13 (TB378FC).
# USB gadget diagnostics and HTTP log server stay disabled unless
# kernel cmdline explicitly passes tb378fc.debug=1.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /sys/kernel/config
mount -t devpts devpts /dev/pts
mount -t tmpfs -o size=6G,mode=0755 tmpfs /run
mkdir -p /run/evidence
exec </dev/console >/dev/console 2>&1

[ -r /etc/build-id ] && cat /etc/build-id >/run/evidence/build-id.txt
cmdline=$(cat /proc/cmdline)
printf '%s\n' "$cmdline" >/run/evidence/cmdline.txt

# Bring any offline CPUs online if booted with a restricted maxcpus setting.
for cpu in 1 2 3 4 5 6 7; do
    if [ -w "/sys/devices/system/cpu/cpu$cpu/online" ] && \
       [ "$(cat "/sys/devices/system/cpu/cpu$cpu/online" 2>/dev/null || echo 1)" = "0" ]; then
        echo 1 >"/sys/devices/system/cpu/cpu$cpu/online" || true
    fi
done

setup=0
debug=0
root_spec=
for token in $cmdline; do
    case "$token" in
        tb378fc.setup=1) setup=1 ;;
        tb378fc.debug=1) debug=1 ;;
        tb378fc.root=*) root_spec=${token#tb378fc.root=} ;;
    esac
done

start_debug_channel() {
    [ "$debug" = "1" ] || return 0
    if [ -x /bin/usb-diag ]; then
        /bin/usb-diag >/run/evidence/usb-setup.txt 2>&1 &
    fi
    if command -v httpd >/dev/null 2>&1; then
        httpd -p 8081 -h /run/evidence
    fi
}

fail() {
    echo "TB378FC_INIT_FAILED $*" | tee /run/evidence/root-stage.txt
    dmesg >/run/evidence/dmesg.txt 2>&1 || true
    if [ "$debug" = "1" ]; then
        start_debug_channel
        sleep 90
    else
        sleep 5
    fi
    if [ -x /bin/reboot-bootloader ]; then
        /bin/reboot-bootloader
    else
        reboot -f
    fi
    while :; do sleep 1; done
}

if [ "$setup" = "0" ] && [ -c /dev/watchdog0 ]; then
    watchdog -F -T 30 -t 5 /dev/watchdog0 &
fi

# Unified v7.4 kernels build UFS/ext4/squashfs/overlay in; keep optional module list for tests.
if [ -s /etc/early-modules ]; then
    echo TB378FC_EARLY_MODULES >/dev/kmsg
    while IFS= read -r module; do
        case "$module" in
            ""|\#*) continue ;;
        esac
        insmod "/lib/modules/$module" >>/run/evidence/early-modules.txt 2>&1 || fail "module:$module"
    done </etc/early-modules
fi
cat /proc/uptime >/run/evidence/storage-probe-uptime.txt

if [ "$setup" = "1" ]; then
    start_debug_channel
    export TB378FC_PREPARED=1
    if [ -x /bin/desktop-init ]; then
        exec /bin/desktop-init
    elif [ -x /bin/desktop-init79 ]; then
        exec /bin/desktop-init79
    fi
    fail setup-exec
fi

start_debug_channel

echo TB378FC_FIND_ROOT_VOLUME | tee /run/evidence/root-stage.txt
if [ -z "$root_spec" ] && [ -r /etc/root-uuid ]; then
    expected=$(cat /etc/root-uuid)
    [ -n "$expected" ] && root_spec="UUID=$expected"
fi
volume=
for _ in $(seq 1 60); do
    if [ -n "$root_spec" ]; then
        volume=$(findfs "$root_spec" 2>/dev/null) && [ -n "$volume" ] && break
    else
        volume=$(findfs "PARTLABEL=ubuntu" 2>/dev/null) && [ -n "$volume" ] && break
        volume=$(findfs "PARTLABEL=linux_rootfs" 2>/dev/null) && [ -n "$volume" ] && break
    fi
    sleep 1
done
[ -n "$root_spec" ] || root_spec="PARTLABEL=ubuntu|linux_rootfs"
[ -n "$volume" ] || fail "missing-root-volume:$root_spec"

mkdir -p /run/tb378fc-root /run/desktop/minimal /run/desktop/standard /newroot
mount -t ext4 -o rw,noatime "$volume" /run/tb378fc-root || fail root-mount

if [ -f /run/tb378fc-root/.tb378fc-root ] && \
   [ -f /run/tb378fc-root/layers/minimal.squashfs ] && \
   [ -f /run/tb378fc-root/layers/minimal.standard.squashfs ]; then
    mount -t squashfs -o ro,loop /run/tb378fc-root/layers/minimal.squashfs /run/desktop/minimal || fail minimal
    mount -t squashfs -o ro,loop /run/tb378fc-root/layers/minimal.standard.squashfs /run/desktop/standard || fail standard
    mount -t overlay overlay \
        -o lowerdir=/run/desktop/standard:/run/desktop/minimal,upperdir=/run/tb378fc-root/upper,workdir=/run/tb378fc-root/work \
        /newroot || fail overlay
else
    # Direct ext4 rootfs layout (no overlay layers)
    mount --move /run/tb378fc-root /newroot || fail direct-root-move
fi

[ -r /etc/build-id ] && cp /etc/build-id /newroot/etc/tb378fc-build-id

# Ensure private Mesa 26.2.6 (Adreno 830 explicit-sync + Turnip) overrides unpatched system Mesa
# even for AT_SECURE/cap_sys_nice binaries like gnome-shell and GDM initial-setup.
if [ -d /newroot/usr/lib/tb378fc/mesa/lib ]; then
    mkdir -p /newroot/etc/ld.so.conf.d /newroot/etc/glvnd/egl_vendor.d /newroot/etc/vulkan/icd.d
    need_ldconfig=0
    if [ ! -f /newroot/etc/ld.so.conf.d/00-tb378fc-mesa.conf ]; then
        printf '%s\n' '/usr/lib/tb378fc/mesa/lib' >/newroot/etc/ld.so.conf.d/00-tb378fc-mesa.conf
        need_ldconfig=1
    fi
    cat >/newroot/etc/glvnd/egl_vendor.d/10_tb378fc_mesa.json <<'EOF'
{
    "file_format_version" : "1.0.0",
    "ICD" : {
        "library_path" : "/usr/lib/tb378fc/mesa/lib/libEGL_mesa.so.0"
    }
}
EOF
    cat >/newroot/etc/vulkan/icd.d/10_tb378fc_freedreno.json <<'EOF'
{
    "file_format_version": "1.0.1",
    "ICD": {
        "library_path": "/usr/lib/tb378fc/mesa/lib/libvulkan_freedreno.so",
        "api_version": "1.4.335"
    }
}
EOF
    if [ "$need_ldconfig" = "1" ] || [ ! -s /newroot/etc/ld.so.cache ]; then
        chroot /newroot /sbin/ldconfig 2>/dev/null || /newroot/sbin/ldconfig.real -r /newroot 2>/dev/null || true
    fi
fi

if [ "$debug" = "1" ]; then
    mkdir -p /run/systemd/system/multi-user.target.wants \
             /run/systemd/system/getty.target.wants \
             /run/systemd/system/serial-getty@ttyGS0.service.d \
             /run/systemd/system/ssh.service.d \
             /run/tb378fc-diag/cgi-bin

    # 1. ttyGS0 (USB ACM COM port) autologin root serial shell
    cat >/run/systemd/system/serial-getty@ttyGS0.service.d/tb378fc-debug.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear --noissue -L ttyGS0 115200 vt100
EOF
    ln -sf /usr/lib/systemd/system/serial-getty@.service /run/systemd/system/getty.target.wants/serial-getty@ttyGS0.service

    # 2. Ephemeral USB SSH root key auth (nothing written to persistent rootfs!)
    cat >/run/tb378fc-diag/authorized_keys <<'EOF'
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBGu+jfcayd3otcwvpVyWmQZoouj6yuoGVLX8BxCFyF6 tb378fc-usb-diag
EOF
    chmod 0600 /run/tb378fc-diag/authorized_keys
    cat >/run/systemd/system/ssh.service.d/tb378fc-debug.conf <<'EOF'
[Service]
ExecStart=
ExecStart=/usr/sbin/sshd -D -o PermitRootLogin=prohibit-password -o PubkeyAuthentication=yes -o AuthorizedKeysFile=/run/tb378fc-diag/authorized_keys
EOF

    # 3. HTTP health, wb-capture, and root diagnostic exec endpoints (bound on USB NCM)
    cat >/run/tb378fc-diag/cgi-bin/health <<'EOF'
#!/bin/sh
echo "Content-Type: text/plain"
echo ""
echo "=== UNAME & TAINTED ==="
uname -a
echo "tainted=$(cat /proc/sys/kernel/tainted)"
echo "=== DF ROOT ==="
df -h /
echo "=== GNOME-SHELL MESA MAPS ==="
pid=$(pidof gnome-shell | awk '{print $1}')
echo "gnome-shell pid=$pid"
if [ -n "$pid" ] && [ -r "/proc/$pid/maps" ]; then
    grep -E "mesa|gallium|gbm|vulkan|dri" "/proc/$pid/maps" | awk '{print $6}' | sort -u
fi
echo "=== FB-READ METADATA ==="
/run/initramfs/bin/fb-read 2>&1 || true
echo "=== DRM & BACKLIGHT ==="
for s in /sys/class/drm/*/status /sys/class/drm/*/modes; do
    [ -e "$s" ] && { echo "--- $s ---"; head -n 8 "$s"; }
done
ls -la /sys/class/backlight/ 2>&1
echo "=== SOUND CARDS ==="
cat /proc/asound/cards 2>&1
echo "=== WIFI / BT / SENSORS / CAM ==="
ip -br link
systemctl is-active bluetooth NetworkManager iio-sensor-proxy tb378fc-sensord 2>&1 || true
echo "=== DMESG ERRORS ==="
dmesg | grep -iE "adreno|dpu|ubwc|dsi|aw88480|wcd939x|ath12k|bluetooth|camss|ov13b10|gc08a8|error|fail" | tail -n 60
EOF
    chmod 0755 /run/tb378fc-diag/cgi-bin/health

    cat >/run/tb378fc-diag/cgi-bin/exec <<'EOF'
#!/bin/sh
echo "Content-Type: text/plain"
echo ""
cmd=$(cat)
if [ -z "$cmd" ]; then
    echo "EMPTY_CMD"
    exit 0
fi
eval "$cmd" 2>&1
echo ""
echo "EXIT_CODE=$?"
EOF
    chmod 0755 /run/tb378fc-diag/cgi-bin/exec

    cat >/run/tb378fc-diag/cgi-bin/reboot-fastboot <<'EOF'
#!/bin/sh
echo "Content-Type: text/plain"
echo ""
echo "REBOOTING_TO_FASTBOOT"
( sleep 1; /run/initramfs/bin/reboot-bootloader ) >/dev/null 2>&1 &
EOF
    chmod 0755 /run/tb378fc-diag/cgi-bin/reboot-fastboot

    cat >/run/systemd/system/tb378fc-usb-diag-http.service <<'EOF'
[Unit]
Description=TB378FC opt-in debug USB NCM & HTTP endpoint
After=network-pre.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in usb0 ncm0 eth0; do if [ -d "/sys/class/net/$i" ]; then ip link set "$i" up; ip addr add 169.254.77.2/16 dev "$i" 2>/dev/null || true; ip addr add 192.168.77.2/24 dev "$i" 2>/dev/null || true; fi; done'
ExecStart=/run/initramfs/bin/busybox httpd -f -p 8081 -h /run/tb378fc-diag
Restart=always
EOF
    ln -sf ../tb378fc-usb-diag-http.service /run/systemd/system/multi-user.target.wants/tb378fc-usb-diag-http.service
fi

mkdir -p /run/initramfs/bin /run/initramfs/dev /run/initramfs/proc /run/initramfs/sys /run/initramfs/run
if [ -x /bin/busybox ]; then
    cp /bin/busybox /run/initramfs/bin/busybox
    for tool in reboot-bootloader wb-capture fb-read kms-test; do
        [ -x "/bin/$tool" ] && cp "/bin/$tool" "/run/initramfs/bin/$tool"
    done
    for app in sh mount umount sync losetup reboot poweroff halt sleep; do
        ln -sf busybox "/run/initramfs/bin/$app"
    done
fi
for shutdown_bin in /bin/tb378fc-shutdown /bin/shutdown /bin/persistent-shutdown80; do
    if [ -x "$shutdown_bin" ]; then
        cp "$shutdown_bin" /run/initramfs/shutdown
        chmod 0755 /run/initramfs/shutdown
        break
    fi
done

echo "TB378FC_ROOT_READY spec=$root_spec device=$volume" | tee /run/evidence/root-stage.txt
cat /proc/mounts >/run/evidence/persistent-mounts.txt
mkdir -p /newroot/run /newroot/dev /newroot/proc /newroot/sys
for process in /proc/[0-9]*; do
    pid=${process##*/}
    [ "$pid" = 1 ] || [ ! -e "$process/exe" ] || kill "$pid" 2>/dev/null || true
done
sleep 1
for process in /proc/[0-9]*; do
    pid=${process##*/}
    [ "$pid" = 1 ] || [ ! -e "$process/exe" ] || kill -KILL "$pid" 2>/dev/null || true
done
mount --move /dev /newroot/dev || fail move-dev
mount --move /proc /newroot/proc || fail move-proc
mount --move /sys /newroot/sys || fail move-sys
mount --move /run /newroot/run || fail move-run
exec switch_root /newroot /sbin/init
